/* components/admin/arcade-query/arcade-query.wxss */
@import "../common/query-common.wxss";

.list-body image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.list-body .user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.list-body .nickname {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.list-body .time {
  font-size: 24rpx;
  color: #999;
}

.list-body .user-stats {
  display: flex;
  gap: 20rpx;
  margin: 5rpx 0;
}

.list-body .stat-item {
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.list-body .stat-item.exp {
  background-color: #f0f9ff;
  color: #0369a1;
}

.list-body .stat-item.balance {
  background-color: #f0fdf4;
  color: #166534;
}

.list-body .operation {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  min-width: 60rpx;
  text-align: center;
}

.list-body .operation.enter {
  background-color: #e8f5e8;
  color: #52c41a;
}

.list-body .operation.leave {
  background-color: #fff2e8;
  color: #fa8c16;
}

.empty-message {
  padding: 60rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}