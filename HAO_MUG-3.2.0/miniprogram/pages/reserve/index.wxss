  .avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    background-color: #eee;
  }
  */
  
  /* 昵称列 */
  .col-1.nickname {
    flex: 1;
    font-size: 28rpx;
    color: #495057;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* 通用空状态提示 */
  .empty-tip {
    text-align: center;
    padding: 40rpx 20rpx;
    color: #868e96;
    font-size: 28rpx;
    margin-top: 20rpx; /* 与列表容器保持距离 */
  }

  .card-fade {
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
  }
  .card-fade.fade-out {
    opacity: 0;
    transform: translateY(10px);
  }
  .card-fade.fade-in {
    opacity: 1;
    transform: translateY(0);
  }