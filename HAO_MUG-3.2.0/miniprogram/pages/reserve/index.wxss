/* 容器样式 */
.container {
    padding: 20rpx 0rpx 60rpx;
    background: #f4f7f9;
    min-height: 100vh;
    box-sizing: border-box;
    /* page 在 app.wxss 里被固定为 height:100% 且是 flex column，
       不加 flex-shrink:0 时容器会被压缩到一屏高，内部卡片随之被压扁、
       内容被 overflow:hidden 裁掉（日历最后一行、说明最后一行消失） */
    flex-shrink: 0;
  }

  /* 卡片不允许被 flex 压缩：内容多高就占多高，超出由页面滚动 */
  .card {
    flex-shrink: 0;
  }

  .card {
    width: 95%;
    margin: 30rpx auto;
    background-color: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.07);
    overflow: hidden;
    animation: slide-up 0.5s ease-out forwards;
  }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px) }
    to { opacity: 1; transform: translateY(0); }
  }

  .card-content {
    padding: 30rpx;
  }

  .card-title {
    position: relative;
    font-size: 32rpx;
    font-weight: 600;
    color: #2c3e50;
    padding: 25rpx 30rpx 25rpx 45rpx;
    border-bottom: 1rpx solid #f0f2f5;
    display: flex;
    align-items: center;
  }
  .card-title::before {
    content: '';
    position: absolute;
    left: 20rpx;
    top: 50%;
    transform: translateY(-50%);
    width: 8rpx;
    height: 30rpx;
    background: linear-gradient(135deg, #66a6ff, #89f7fe);
    border-radius: 4rpx;
  }
  

  /* 月历区域 */
  .calendar {
    width: 95%;
    margin: 30rpx auto;
    background-color: #ffffff;
    border-radius: 24rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.07);
    padding: 20rpx 16rpx 30rpx;
    box-sizing: border-box;
  }

  .calendar-header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10rpx 0 20rpx;
  }

  .calendar-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #2c3e50;
  }

  .calendar-weekdays {
    display: flex;
    padding-bottom: 10rpx;
  }

  .weekday-cell {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    color: #868e96;
    font-weight: 500;
  }

  .calendar-grid {
    display: flex;
    flex-wrap: wrap;
    padding: 6rpx 0;
  }

  .calendar-cell {
    width: 14.2857%;
    box-sizing: border-box;
    padding: 6rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .empty-cell {
    visibility: hidden;
  }

  .day-cell {
    height: 110rpx;
  }

  .day-cell .day-num {
    width: 64rpx;
    height: 64rpx;
    line-height: 64rpx;
    text-align: center;
    border-radius: 50%;
    font-size: 30rpx;
    font-weight: 500;
    position: relative;
    z-index: 1;
  }

  /* 四档人数状态 */
  .day-cell.level-low .day-num {
    background-color: #e8f5e9;
    color: #2e7d32;
  }

  .day-cell.level-medium .day-num {
    background-color: #fff3e0;
    color: #e65100;
  }

  .day-cell.level-high .day-num {
    background-color: #ffebee;
    color: #c62828;
  }

  .day-cell.level-full .day-num {
    background-color: #f3d5dc;
    color: #870031;
  }

  /* 今天：外圈高亮边框 */
  .day-cell.today .day-num {
    box-shadow: 0 0 0 4rpx rgba(74, 144, 226, 0.35);
    font-weight: 700;
  }

  /* 选中日期：深色描边选中框（用 outline 不影响相邻格子、不会被裁切） */
  .day-cell.selected .day-num {
    box-shadow: 0 0 0 4rpx #4a90e2;
    font-weight: 700;
  }

  /* 过去日期：置灰不可点 */
  .day-cell.disabled {
    opacity: 0.35;
  }
  .day-cell.disabled .day-num {
    background-color: #f0f0f0;
    color: #b0b0b0;
  }

  /* 「我的预约」对勾：右下角圆形绿色底 + 白色勾 */
  .reserve-check {
    position: absolute;
    bottom: 2rpx;
    right: 4rpx;
    width: 36rpx;
    height: 36rpx;
    line-height: 36rpx;
    text-align: center;
    border-radius: 50%;
    background-color: #2e7d32;
    color: #ffffff;
    font-size: 22rpx;
    font-weight: 700;
    z-index: 2;
  }

  /* 1 号格子左上角的月份标注（跨月时标出下个月） */
  .month-label {
    position: absolute;
    top: 0rpx;
    left: 2rpx;
    font-size: 18rpx;
    line-height: 1;
    color: #868e96;
    z-index: 2;
  }

  /* 图例 */
  .calendar-legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12rpx 24rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f2f5;
    margin-top: 16rpx;
  }

  .legend-item {
    display: flex;
    align-items: center;
    font-size: 22rpx;
    color: #868e96;
  }

  .legend-dot {
    width: 20rpx;
    height: 20rpx;
    border-radius: 50%;
    margin-right: 6rpx;
    flex-shrink: 0;
  }

  .dot-low { background-color: #e8f5e9; border: 1rpx solid #2e7d32; }
  .dot-medium { background-color: #fff3e0; border: 1rpx solid #e65100; }
  .dot-high { background-color: #ffebee; border: 1rpx solid #c62828; }
  .dot-full { background-color: #f3d5dc; border: 1rpx solid #870031; }
  .dot-mine {
    background-color: #2e7d32;
    border: 1rpx solid #2e7d32;
    color: #ffffff;
    font-size: 18rpx;
    font-weight: 700;
    line-height: 20rpx;
    text-align: center;
  }

  
  
  /* 用户信息 */
  .reserve-card .card-title {
    justify-content: space-between;
  }
  .reserve-card .card-title text {
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 15rpx;
  }
  .credit-badge {
    flex-shrink: 0;
    font-size: 24rpx;
    font-weight: 500;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    background-color: #e9ecef;
    color: #6c757d;
  }

  /* 信用等级颜色类 */
  .credit-S { color: #FFD700; background-color: rgba(255, 215, 0, 0.1); border: 1rpx solid #FFD700;} /* 金色 */
  .credit-A { color: #52C41A; background-color: rgba(82, 196, 26, 0.1); border: 1rpx solid #52C41A;} /* 绿色 */
  .credit-B { color: #1890FF; background-color: rgba(24, 144, 255, 0.1); border: 1rpx solid #1890FF;} /* 蓝色 */
  .credit-C { color: #FF4949; background-color: rgba(255, 73, 73, 0.1); border: 1rpx solid #FF4949;} /* 红色 */
  
  
  .info-row {
    display: flex;
    justify-content: space-around;
    margin-bottom: 45rpx;
    padding: 30rpx 15rpx;
    background: linear-gradient(135deg, #f5f7fa 0%, #e8f1f9 100%);
    border-radius: 16rpx;
    box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }

  .info-item + .info-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 2rpx;
    height: 60%;
    background-image: linear-gradient(180deg, rgba(195, 207, 226, 0), rgba(195, 207, 226, 1), rgba(195, 207, 226, 0));
  }
  .info-item {
    position: relative;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .info-item .label {
    font-size: 26rpx;
    color: #868e96;
    margin-bottom: 10rpx;
  }

  .info-item .value {
    font-size: 38rpx;
    font-weight: 600;
    color: #34495e;
  }
  .info-item .value.primary {
    color: #4a90e2;
  }
  
  button[type="primary"] {
    background: linear-gradient(135deg, #5baff0 0%, #3a8ce0 100%);
    border-radius: 50rpx;
    font-size: 32rpx;
    height: 92rpx;
    /* line-height: 92rpx; */
    box-shadow: 0 8rpx 20rpx rgba(58, 140, 224, 0.25);
    transition: all 0.3s ease;
    border: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.1s ease-out;
  }
  button[type="primary"]::after {
    border: none;
  }
  button[type="primary"]:active {
    background: linear-gradient(135deg, #3a8ce0 0%, #2e6cb1 100%);
    box-shadow: 0 4rpx 10rpx rgba(58, 140, 224, 0.35);
    transform: scale(0.98);
  }
  
  button[type="primary"][disabled] {
    background: linear-gradient(135deg, #d8dde2 0%, #c1c8ce 100%);
    box-shadow: none;
    color: #ffffff;
    opacity: 0.7;
  }
  
  /* 状态提示 */
  .qualification-tip {
    font-size: 24rpx;
    text-align: center;
    margin-top: 20rpx;
    padding: 10rpx;
    border-radius: 8rpx;
  }

  
/* 说明区域 */
.reserve-notice {
    display: flex;
    align-items: flex-start;
    background-color: #fff7e6; 
    border-radius: 12rpx;
    padding: 20rpx 25rpx;
    margin-top: 10rpx;
    margin-bottom: 10rpx;
    border: 1rpx solid #ffe5b3;
    width: 87%;
  }
  
  .notice-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 15rpx;
    flex-shrink: 0;
    /* margin-top: 4rpx; */
  }
  /* .notice-icon image {
      width: 100%;
      height: 100%;
      display: block;
  } */
  
  .notice-content {
    font-size: 26rpx;
    color: #8c6d3f; 
    line-height: 1.6;
    flex: 1;
  }

  .notice-line {
      display: block;
  }
  
  /* 强调样式 */
  .notice-content .highlight {
    font-weight: 600;
    color: #d97706;
  }
  
  .notice-content .highlight.strong {
      color: #e54d42;
      font-size: 28rpx;
  }
  
  /* 加载提示 */
  .loading-tip {
    text-align: center;
    padding: 40rpx 20rpx;
    color: #868e96;
    font-size: 28rpx;
  }
  
  /* 表格容器 */
  .table-container {
    /* 可以设置最大高度和滚动条，如果列表可能很长 */
    /* max-height: 400rpx; */
    /* overflow-y: auto; */
  }
  
  /* 表格行 */
  .table-row {
    display: flex;
    align-items: center;
    padding: 20rpx 10rpx;
    border-bottom: 1rpx solid #e9ecef;
  }
  .table-row:last-child {
    border-bottom: none;
  }
