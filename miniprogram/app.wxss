/**app.wxss**/
page {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    /* 静态渐变背景：原先是 gradient-move 20s 无限循环动画，
       会让每个页面持续重绘、拖慢整机。改成静态渐变即可，视觉几乎不变。 */
    background: linear-gradient(125deg, #f0faff, #e6f7ff, #fdfdff, #fff0f5);
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

.card {
    transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
                box-shadow 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}
.card-hover {
    transform:translateY(-8rpx);
    box-shadow: 0 16rpx 35rpx rgba(0, 0, 0, 0.08);
}


page, .page {
    height: 100%;
}