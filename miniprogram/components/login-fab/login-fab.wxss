/* components/login-fab/login-fab.wxss */

/* 可拖拽区域，铺满全屏，且不影响下层元素的点击 */
.movable-area {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  pointer-events: none;
}

/* 可拖拽的视图，让它可以响应触摸 */
.movable-view {
  pointer-events: auto; /* 让球可以被拖动 */
  width: 140rpx;
  height: 140rpx;
  opacity: 0;
  transform: scale(0.8);
  transition: left 0.4s ease-out, transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), left 0.3s ease-out, top 0.3s ease-out;
}
.movable-view.fab-fade-in {
  opacity: 1;
  transform: scale(1);
}

/* 球形按钮的视觉样式 */
.fab-ball {
  width: 100%;
  height: 100%;
  border-radius: 50%; /* 变成圆形 */
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  box-shadow: 0 10rpx 25rpx rgba(79, 172, 254, 0.4);
  
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  
  color: white;
  animation: fab-bounce-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}


@keyframes fab-bounce-in {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.fab-text {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
}