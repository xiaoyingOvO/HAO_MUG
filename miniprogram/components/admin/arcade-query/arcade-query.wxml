<!--components/admin/arcade-query/arcade-query.wxml-->
<import src="../common/filterBar.wxml"/>

<view class="module-content">
  <view class="list-info-bar">
    <view class="list-info-filter">
      <view>
        <input value="{{nicknameInput}}" placeholder="可通过昵称搜索用户" placeholder-style="font-size: 30rpx" bind:input="onInput" />
        <view wx:if="{{userList.length > 0}}" class="search-result">
          <view wx:for="{{userList}}" wx:key="_id" class="search-result-item" bind:tap="selectUser" data-user="{{item}}">
            {{item.nickname}}
          </view>
        </view>
      </view>
      <button size="mini" bind:tap="clearFilter">清空筛选</button>
    </view>

    <view class="time-picker-container">
      <picker mode="date" value="{{filter.startTime}}" bindchange="changeStartTime">
        <button size="mini">
          {{filter.startTime || '任意时间'}}
        </button>
      </picker>
      <text>至</text>
      <picker mode="date" value="{{filter.endTime}}" bindchange="changeEndTime">
        <button size="mini">
          {{filter.endTime || '任意时间'}}
        </button>
      </picker>
    </view>

    <text wx:if="{{filter.openid}}">用户{{filter.openid}}的出入店记录</text>
    <text wx:else>全部用户的出入店记录</text>
  </view>

  <view class="list-body">
    <view wx:for="{{arcadeInfo}}" wx:key="index">
      <image src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="nickname">{{item.nickname}}</text>
        <view wx:if="{{item.exp !== undefined || item.remain_point !== undefined}}" class="user-stats">
          <text wx:if="{{item.exp !== undefined}}" class="stat-item exp">Exp: {{item.exp}}</text>
          <text wx:if="{{item.remain_point !== undefined}}" class="stat-item balance">余额: {{item.remain_point}}</text>
        </view>
        <text class="time">{{item.time}}</text>
      </view>
      <text class="operation {{item.op == 0 ? 'enter' : 'leave'}}">{{item.op == 0 ? '入店' : '出店'}}</text>
    </view>
    <view wx:if="{{filter.openid && arcadeInfo.length == 0}}" class="empty-message">暂无该用户出入店记录</view>
  </view>
</view>