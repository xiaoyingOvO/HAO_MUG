/* components/admin/door-query/door-query.wxss */
@import "../common/query-common.wxss";

.list-body .door-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 15rpx;
}

.list-body .door-item:last-child {
  border-bottom: none;
}

.list-body image {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 15rpx;
}

.list-body .user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.list-body .nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.list-body .time {
  font-size: 22rpx;
  color: #666;
}

.door-action {
  padding: 6rpx 12rpx;
  background-color: #e8f5e8;
  border-radius: 16rpx;
  align-self: flex-start;
  margin-top: 5rpx;
  font-size: 22rpx;
  color: #52c41a;
  font-weight: 500;
}

.empty-message {
  padding: 60rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}