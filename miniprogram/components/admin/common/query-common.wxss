/* components/admin/common/query-common.wxss */

.module-content {
  padding: 20rpx;
}

.list-info-bar {
  background-color: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.list-info-filter {
  display: flex;
  gap: 25rpx;
  justify-content: space-between;
  align-items: center;
}

.list-info-filter view:first-child {
  position: relative;
  flex: 1;
}

.list-info-filter view:first-child input {
  padding: 15rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.list-info-filter .search-result {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  max-height: 300rpx;
  overflow-y: auto;
  z-index: 100;
}

.search-result-item {
  padding: 15rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  color: #333;
  transition: background-color 0.2s ease;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:hover {
  background-color: #f5f5f5;
}

.search-result-item:active {
  background-color: #e6f7ff;
}

.list-info-bar text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.list-info-bar button {
  align-self: flex-end;
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.list-info-bar button:active {
  background-color: #0056cc;
  transform: scale(0.95);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.time-picker-container {
  display: flex;
  flex-direction: row;
  gap: 30rpx;
  justify-content: center;
  align-items: center;
  margin: 10rpx 0;
}

.time-picker-container button {
  background-color: #f8f9fa;
  color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 6rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.time-picker-container button:active {
  background-color: #e9ecef;
  transform: scale(0.96);
  border-color: #ced4da;
}

.list-body {
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.list-body > view {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.list-body > view:last-child {
  border-bottom: none;
}
