/* components/admin/send-mail/send-mail.wxss */
.card {
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 25rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #e9ecef;
}
.primary-button {
  background-color: linear-gradient(87deg, #5e72e4 0, #8898f0 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(94, 114, 228, 0.15);
}
.primary-button.disabled {
  background-color: #a0cfff;
}
.primary-button::after { border: none; }


.send-mail-container .panel {
  padding: 0;
  overflow: hidden;
}
.send-mail-container::after {
  content: '';
  display: block;
  height: 400px;
}

.section {
  padding: 35rpx;
  border-bottom: 1rpx solid #e9ecef;
  transition: background-color 0.3s;
}
.section:last-child {
  border-bottom: none;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #32325d;
  margin-bottom: 35rpx;
  position: relative;
  padding-left: 25rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #5e72e4;
  border-radius: 4rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-item .label {
  display: block;
  font-size: 28rpx;
  color: #525f7f;
  margin-bottom: 15rpx;
  font-weight: 500;
}
.label-optional {
  font-size: 24rpx;
  color: #8898aa;
  margin-left: 10rpx;
}

/* 发送选项 */
.send-type-group {
  display: flex;
}
.radio {
  font-size: 28rpx;
  margin-right: 40rpx;
  color: #525f7f;
}
.radio radio .wx-radio-input.wx-radio-input-checked {
  background-color: #5e72e4 !important;
  border-color: #5e72e4 !important;
}

/* 收件人 */
.recipient-input-area {
  position: relative;
}
.recipient-display {
  display: flex;
  align-items: center;
  height: 92rpx;
  border: 1rpx solid #e9edf0;
  border-radius: 12rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  transition: all 0.2s ease;
}
.recipient-display.disabled {
  background-color: #f7fafc;
  color: #909399;
}
.recipient-display.selected {
  background-color: #eef2ff;
  border-color: #8898f0;
}
.selected-avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #ffffff;
}
.selected-nickname {
  flex: 1;
  color: #32325d;
  font-weight: 500;
}
.clear-btn {
  width: 40rpx;
  height: 40rpx;
  padding: 5rpx;
  opacity: 0.7;
  transition: opacity 0.2s;
}
.clear-btn:active {
  transform: scale(0.9)
}
.clear-btn image {
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

/* 搜索框 */
.search-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  gap: 15rpx;
}
.search-input {
  flex: 1;
  height: 92rpx;
  background-color: #f7fafc;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  color: #525f7f;
}
.search-input.focus {
  background-color: #ffffff;
  border-color: #5e72e4;
  box-shadow: 0 0 0 6rpx rgba(94, 114, 228, 0.15);
  color: #32325d;
}
.search-loading-indicator {
  position: absolute;
  right: 25rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #8898aa;
}

/* 搜索结果 */
.search-results-popup {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.12);
  z-index: 100;
  max-height: 400rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  opacity: 0;
  transform: translateY(-10rpx) scale(0.98);
  transform-origin: top center;
  transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  pointer-events: none;
}
.search-results-popup.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}
.search-results-scroll {
  max-height: 400rpx;
}

.popup-close-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: transparent;
  z-index: 99;

}

.result-item {
  display: flex;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #e9edf0;
  transition: background-color 0.2s;
}
.result-item:last-child {
  border-bottom: none;
}
.result-item.hover {
  background-color: #eef2ff;
}
.item-avatar {
  width: 100rpx;
  height: 100rpx;
  margin-right: 25rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}
.item-nickname {
  color: #32325d;
}
.empty-search-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #8898aa;
}

/* 内容编辑 */
.content-section {
  border-bottom: none;
  background-color: #fcfdff;
}
.value-input {
  width: 100%;
  height: 80rpx;
  background-color: #f7fafc;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 0 25rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: all 0.25s ease-in-out;
  color: #525f7f;
}
.value-input.focus {
  background-color: #ffffff;
  border-color: #5e72e4;
  box-shadow: 0 0 0 6rpx rgba(94, 114, 228, 0.15);
  color: #32325d;
}
.textarea-wrapper {
  position: relative;
}
.message-textarea {
  width: 100%;
  height: 280rpx;
  background-color: #f7fafc;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 25rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
  transition: all 0.2s ease;
  color: #525f7f;
}
.message-textarea.focus {
  background-color: #ffffff;
  border-color: #5e72e4;
  box-shadow: 0 0 0 6rpx rgba(94, 114, 228, 0.15);
}
.char-counter {
  position: absolute;
  bottom: 15rpx;
  right: 20rpx;
  font-size: 24rpx;
  color: #8898aa;
}

.action-footer {
  padding: 30rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e9ecef;
  border-bottom-left-radius: 20rpx;
}
.send-btn {
  width: 100%;
  height: 92rpx;
  line-height: 65rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #07c160;
  transition: transform 0.1s ease-out, box-shadow 0.2s ease;
}
.send-btn:not(disabled):active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(94, 114, 228, 0.4);
}