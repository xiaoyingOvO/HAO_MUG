/* components/faq-modal/faq-modal.wxss */
.modal-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .modal-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
  }
  
  .modal-container {
    width: 85%;
    max-width: 700rpx;
    background: rgba(40, 42, 58, 0.95);
    border: 1rpx solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, 0.4);
    border-radius: 24rpx;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    position: relative;
    z-index: 1;
  }
  
  .modal-title {
    flex-shrink: 0;
    padding: 30rpx;
    font-size: 34rpx;
    font-weight: bold;
    text-align: center;
    color: #e0e6f0;
    border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
  }
  
  .modal-content-scroll {
    flex: 1;
    min-height: 100rpx;
    overflow-y: auto;
  }
  .faq-list {
      padding: 10rpx 30rpx 30rpx 30rpx;
      box-sizing: border-box;
  }
  .faq-item {
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
    padding: 25rpx 0;
  }
  .faq-item:last-child {
    margin-bottom: none;
  }
  
  .faq-question {
    font-size: 30rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 15rpx;
    line-height: 1.5;
    color: #c0c0e0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .question-text {
      flex: 1;
      word-break: break-word;
  }
  
  .faq-answer {
    font-size: 28rpx;
    color: #555;
    line-height: 1.7;
    color: #a0a0c0;
  }

  .arrow {
    width: 16rpx;
    height: 16rpx;
    border-right: 4rpx solid #888;
    border-bottom: 4rpx solid #888;
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-left: 20rpx;
  }
  .faq-item.opened .arrow {
    transform: rotate(-135deg);
  }
  
  .faq-image {
    width: 100%;
    border-radius: 12rpx;
    margin-top: 15rpx;
    background-color: #f5f5f5; /* 图片加载前的占位背景 */
  }
  
  .modal-footer {
      flex-shrink: 0;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .confirm-button {
    width: 100%;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(45deg, #667eea, #764ba2);
    color: #e3f2fd;
    font-size: 34rpx;
    font-weight: 500;
    border-radius: 50rpx;
    margin-top: 50rpx;
    position: relative;
    overflow: hidden;
  }
  .confirm-button::after {
    border: none;
  }
  .confirm-button:active {
      opacity: 0.9;
      transform: scale(0.98);
  }