/* components/card/card.wxss */

/* 卡（跟"游玩位"一样的样式） */
.playlist-item {
  position: relative;      /* 给右上角「我」的角标做定位基准 */
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 3rpx solid #07C160;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}

/* 卡的右上角「红角」：不写字，只标出哪张是自己。
   top / right 用 -3rpx 是为了正好盖住卡片那 3rpx 的绿色边框 */
.my-corner {
  position: absolute;
  top: -3rpx;
  right: -3rpx;
  width: 0;
  height: 0;
  border-top: 46rpx solid #FF4D4F;
  border-left: 46rpx solid transparent;
  border-top-right-radius: 14rpx;
  z-index: 2;
}

.player-index {
  font-size: 30rpx;
  color: #07C160;
  font-weight: 600;
  min-width: 40rpx;
  /* 排队号最多两位数，固定宽度让所有卡的数字左对齐，扫一眼就是一列 */
  text-align: center;
  flex: none;
}

/* 队首（1 号）：整张卡换成橙色边框 + 数字变色，配合昵称下面的「下一位上机」 */
.playlist-item.is-next {
  border-color: #ff9800;
  box-shadow: 0 4rpx 14rpx rgba(255, 152, 0, 0.28);
}
.player-index.is-next {
  color: #ff6b00;
  font-weight: 700;
}

.player-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;   /* 允许子元素收缩，长昵称才不会把卡片撑爆 */
}

.player-info > image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  flex: none;
  background: #e9ecef;
}

/* 昵称 + 「下一位上机」两行，占的是昵称自己那一列，不再多吃横向空间 */
.player-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.player-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-next {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #ff6b00;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 单刷：贴在卡片最右边，和游玩区玩家卡上的「单刷」位置、样式完全一致
   （红字 + 浅红底 + 红边 + 圆角 8rpx + 22rpx 字）。
   改这里记得同步 pages/queue-info/index.wxss 的 .seat-single-tag / .seat-locked-text。 */
.player-single-tag {
  flex: none;
  margin-left: auto;
  box-sizing: border-box;
  padding: 0 14rpx;
  height: 40rpx;
  line-height: 38rpx;   /* 减掉上下 1rpx 边框，文字正好垂直居中 */
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #e53935;
  background: rgba(229, 57, 53, 0.12);
  border: 1rpx solid rgba(229, 57, 53, 0.25);
}
