/* login.wxss */
.container {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: #1a1a2e;
    padding: 40rpx 20rpx;
    box-sizing: border-box;
  }

  page.page--fixed {
      position: fixed;
      left: 0;
      right: 0;
      overflow: hidden;
  }
  .page--fixed {
      height: 100vh;
      overflow: hidden;
  }
  
  .background-gradient {
      z-index: 0;
    position: absolute;
    width: 250%;
    height: 250%;
    /*background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    animation: gradientRotate 20s linear infinite;*/
    background:
        radial-gradient(circle at 70% 30%, rgba(255,255,255,0.05) 10%, transparent 10.5%),
        radial-gradient(circle at 30% 70%, rgba(255,255,255,0.07) 15%, transparent 15.5%); 
    animation: float 18s linear infinite;
  }
  
  @media (max-width: 360px) {
      .login-card {
          width: 90%;
      }

      .avatar-wrapper {
          width: 140rpx;
          height: 140rpx;
      }

      .input-group {
          margin-bottom: 30rpx;
      }
  }

  @keyframes float {
      0% { transform: translate(0, 0) rotate(0deg);}
      100% { transform: translate(-10%, -5%) rotate(360deg); }
  }

  /*@keyframes gradientRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }*/

  /* LOGO */
  .logo-title-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60rpx; /* 与登录卡片的间距 */
    color: #e0e6f0; /* 浅色文字，对比深色背景 */
    text-align: center;
    z-index: 2;
    /* 初始状态，配合JS动画 */
    /* opacity: 0;
    transform: translateY(20px); */
  }
  .logo-image {
    width: 180rpx;
    height: 180rpx;
    margin-bottom: 20rpx;
    border-radius: 20rpx;
    /* box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.2); 可选阴影 */
  }
  .app-title {
    font-size: 48rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
  }
  .app-subtitle {
    font-size: 28rpx;
    color: #a0a0c0; 
    margin-top: 10rpx;
  }
  
  .login-card {
    width: 88%;
    max-width: 700rpx;
    background: rgba(40, 42, 58, 0.85);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 15rpx 40rpx rgba(0,0,0,0.3);
  position: relative;
  z-index: 2;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  /* 初始状态，配合JS动画 */
  opacity: 0;
  transform: translateY(30px);
    /* background: linear-gradient(145deg, #333, #444);
    border-radius: 20rpx;
    padding: 40rpx;
    box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
    position: relative;
    z-index: 3;
    will-change: transform;
    backface-visibility: hidden; */
  }
  
  .avatar-section {
      min-width: 160rpx;
      min-height: 160rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 60rpx;
    flex-shrink: 0;
  }
  
  .avatar-wrapper {
      padding: 0 !important;
      margin: 0 !important;
      line-height: 1;
      border: none !important;
      width: 180rpx !important;
      height: 180rpx !important;
      border-radius: 50%;
      background: linear-gradient(135deg, #3a3a5a, #4a4a6a);
      box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.25), inset 0 2rpx 4rpx rgba(0,0,0,0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      /* box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.2); */
  }

  .avatar-wrapper::after {
    border: none !important;
  }
  .avatar-wrapper:hover {
      transform: scale(1.05);
      box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3), inset 0 2rpx 4rpx rgba(0,0,0,0.2);
      background: linear-gradient(135deg, #3a3a3a, #4a4a4a);
  }

  .avatar-square {
      width: 100%;
      height: 100%;
      border-radius: 16rpx;
  }

  .avatar-default-square {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 100%;
      background: #3a3a3a;
  }
  
  .avatar-wrapper:active {
    transform: scale(0.95);
  }
  
  .avatar {
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  
  .avatar-default {
    width: 100%;
    height: 100%;
    background: #f0f2f5;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: inherit;
  }

 
  
  .camera-icon {
    width: 70rpx;
    height: 70rpx;
    opacity: 0.4;
  }
  
  .avatar-mask {
    position: absolute;
    bottom: 0;
    width: 100%;
    background: rgba(0,0,0,0.5);
    color: white;
    font-size: 24rpx;
    text-align: center;
    padding: 10rpx 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .avatar-wrapper:hover .avatar-mask {
    opacity: 1;
  }
  
  .nickname {
    margin-top: 20rpx;
    font-size: 34rpx;
    color: #e0e0e0;
    text-align: center;
    font-weight: 500;
  }
  
  .input-group {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 35rpx;
    background: #303242/*#f8f9fa*/;
    border-radius: 16rpx;
    padding: 0rpx 30rpx;
    height: 96rpx;
    transition: all 0.3s;
    /* box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1); */
    border: 1rpx solid rgba(255, 255, 255, 0.15);
  }
  .input-group:focus-within {
      border-color: #764ba2;
      box-shadow: 0 0 0 3rpx rgba(118, 75, 162, 0.3);
  }
  

  
  .input-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 20rpx;
    filter: brightness(1.2);
  }
  
  .phone-button {
    width: 100%;
    height: 100%;
    font-size: 30rpx;
    color: #00f7ff;
    border: none;
    border-radius: 16rpx;
    background: none;
    padding: 0;
    margin: 0;
    justify-content: center;
    align-items: center;
    display: flex;
    transition: all 0.3s;
  }
  .phone-button:active {
      background:rgba(0, 255, 255, 0.1);
      transform: scale(0.98);
  }
  
  .input-box, .nickname-input {
    background: transparent;
    flex: 1;
    font-size: 30rpx;
    color: #e0e6f0/*#333*/;
    text-align: center; /* 文字居中对齐 */
    padding: 0 20rpx; /* 防止文字溢出 */
    line-height: normal;
  }
  .placeholder {
      color: #606080;
  }


  .submit-button {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(45deg, #667eea, #764ba2);
    color: #e3f2fd;
    font-size: 34rpx;
    font-weight: 500;
    border-radius: 50rpx;
    margin-top: 50rpx;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease,
                opacity 0.3s ease; 
  }
  
  .submit-button:active {
      transform: translate(0.98);
  }

  .button-hover {
    opacity: 0.9;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
    transform: scale(0.98) translateY(-2rpx);
  }
  
  .button-wave {
    position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0);
      transition: transform 0.5s ease;
  }


  .button-active .button-wave {
      transform: scale(2);
  }

  .guest-enter-button {
    width: 100%;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #a0a0c0;
    font-size: 30rpx;
    border-radius: 16rpx;
    border: 1rpx solid #404258;
    margin-top: 25rpx;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  
  .button-hover-secondary {
    background-color: rgba(64, 66, 88, 0.5);
    color: #c0c0e0;
  }
  
  .decorate-circle {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
  }
  
  .circle-1 {
    width: 400rpx;
    height: 400rpx;
    top: -150rpx;
    right: -150rpx;
  }
  
  .circle-2 {
    width: 300rpx;
    height: 300rpx;
    bottom: -100rpx;
    left: -100rpx;
  }

  /* 底部导航样式 */
.nav-buttons {
    position: fixed;
    bottom: 60rpx;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .nav-text {
    color: #666;
    font-size: 28rpx;
    margin-right: 20rpx;
  }
  
  .nav-button {
    background: none;
    color: #764ba2;
    font-size: 28rpx;
    padding: 0;
    margin: 0;
    line-height: 1;
  }
  
  .nav-button-hover {
    opacity: 0.7;
  }