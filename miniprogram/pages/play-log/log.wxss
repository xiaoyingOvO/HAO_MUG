/* pages/play-log/log.wxss */
page {
  --main-font-size: 16px;
  --tabbar-background-color: rgba(255, 165, 0, 0.5);
  --tabbar-active-color: #f6f6f6;
  --tabbar-inactive-color: transparent;
  --tabbar-active-text-color: rgb(255, 165, 0);
  --log-border-color: rgb(210, 105, 30);
  --log-border-shadow-color: rgba(210, 105, 30, 0.6);
  --log-body-border-color: rgb(255, 165, 0);
  --log-main-font-size: 14px;
  --log-title-font-size: 16px;
  /* font-size: 16px; */
}

.tabbar {
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx 0 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  justify-items: center;
  background: var(--tabbar-background-color);
  backdrop-filter: blur(15px);
  z-index: 1;
}
.tabbar > view {
  position: relative;
  display: inline-block;
  width: 100%;
  line-height: calc(2 * var(--main-font-size));
  text-align: center;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 9;
}
.tab-active {
  background: var(--tabbar-active-color);
  color: var(--tabbar-active-text-color);
}
.tab-inactive {
  background: var(--tabbar-inactive-color);
}

.logs_container {
  width: 100%;
  padding: 12rpx 24rpx 60rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  font-size: var(--log-main-font-size);
}

.play_log {
  border: 1px solid var(--log-border-color);
  box-shadow: 5rpx 5rpx 5rpx var(--log-border-shadow-color);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.play_log > view {
  padding: 12rpx;
}
  .play_log_head {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--log-border-color);
  }
  .play_log_head > view:last-child {
    display: inline-flex;
    gap: 12rpx;
  }
  .play_log > .play_log_body {
    padding: 12rpx 24rpx;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    grid-template-areas: 'a b c d';
    gap: 16rpx;
  }
  .play_log > .play_log_body > view {
    text-align: center;
    border: 1px solid var(--log-body-border-color);
  }
    .play_log_body > view > text:first-child {
      font-size: var(--log-title-font-size);
      font-weight: bold;
    }

.point_log {
  display: grid;
  grid-template-columns: minmax(max-content, 70%) 1fr max-content;
  gap: 12rpx;
  align-items: center;
  justify-items: end;
}
.machine_log {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 20rpx;
  padding: 8rpx 12rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border-left: 3rpx solid #007aff;
  align-items: center;
  min-height: 60rpx;
}

.machine_log > view:first-child {
  font-size: 24rpx;
  font-family: monospace;
  color: #666;
  white-space: nowrap;
}

.machine_log > view:last-child{
  justify-self: start;
  text-align: left;
  font-size: 28rpx;
  color: #333;
}

.machine_log > view:last-child text:first-child {
  font-weight: 500;
  color: #007aff;
  margin-right: 8rpx;
}

.point_log > view:first-child, .machine_log > view:first-child {
  justify-self: start;
}

.empty-message {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
  font-size: 32rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
}