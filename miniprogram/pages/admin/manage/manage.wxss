/* pages/admin/manage/manage.wxss */

.container.manage-page {
  padding: 30rpx;
}
.page-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.header-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: bold;
}
.module-container {
  width: 100%;
  display: block;
  margin-top: 20rpx;
}

.status-container, .list-footer-status {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
