/* pages/mahjong/record.wxss —— 管理员录入页（淡蓝主题） */
.rec-page {
  padding: 24rpx 24rpx 80rpx;
  flex-shrink: 0;
}

.rec-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  flex-shrink: 0;
}
.rec-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d5871;
  margin-bottom: 20rpx;
}

/* 无权限 */
.no-auth {
  text-align: center;
  color: #8aa7c2;
  padding: 80rpx 28rpx;
}
.no-auth-icon { font-size: 80rpx; margin-bottom: 24rpx; }

/* 日期 */
.date-picker {
  background: #eef5fb;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #3d5871;
}

/* 玩家位 */
.slot {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.slot-no {
  width: 100rpx;
  font-size: 26rpx;
  color: #8aa7c2;
}
.slot-picked {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f8fd;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.slot-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #e8f1fa;
}
.slot-name {
  flex: 1;
  font-size: 28rpx;
  color: #3d5871;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slot-points {
  width: 140rpx;
  background: #fff;
  border: 2rpx solid #d6e8f7;
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
  text-align: center;
  margin-right: 14rpx;
}
.slot-remove {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  color: #7fb4e0;
  font-size: 28rpx;
  background: #fff;
  border-radius: 50%;
}
.slot-empty {
  flex: 1;
  text-align: center;
  border: 2rpx dashed #b3d3ee;
  border-radius: 16rpx;
  padding: 22rpx 0;
  color: #7fb4e0;
  font-size: 28rpx;
}

.rec-tip {
  text-align: center;
  font-size: 24rpx;
  color: #aabfd2;
  margin-bottom: 32rpx;
}

.rec-submit {
  background: linear-gradient(90deg, #8fc4ef, #6fb0e6);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(111, 176, 230, 0.35);
}
.rec-submit.disabled { opacity: 0.6; }

/* 搜索弹层 */
.search-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.search-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.search-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
  margin-bottom: 24rpx;
}
.search-input {
  background: #eef5fb;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.search-list {
  max-height: 480rpx;
  overflow-y: auto;
}
.search-item {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #edf3f9;
}
.si-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #e8f1fa;
}
.si-name { font-size: 30rpx; color: #3d5871; }
.search-empty {
  text-align: center;
  color: #aabfd2;
  font-size: 26rpx;
  padding: 48rpx 0;
}
.search-cancel {
  margin-top: 24rpx;
  text-align: center;
  color: #8aa7c2;
  font-size: 30rpx;
  padding: 12rpx 0;
}
