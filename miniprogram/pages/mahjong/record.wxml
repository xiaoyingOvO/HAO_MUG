<!-- pages/mahjong/record.wxml —— 管理员录入一局 -->
<view class="rec-page">

  <!-- 无权限 -->
  <view wx:if="{{checkDone && !isAdmin}}" class="rec-card no-auth">
    <view class="no-auth-icon">🔒</view>
    <view>仅管理员可{{editMode ? '修改' : '录入'}}对局</view>
  </view>

  <view wx:if="{{checkDone && isAdmin && loading}}" class="rec-card no-auth">
    <view>加载中…</view>
  </view>

  <block wx:if="{{checkDone && isAdmin && !loading}}">
    <!-- 对局日期 -->
    <view class="rec-card">
      <view class="rec-label">对局日期</view>
      <picker mode="date" value="{{game_date}}" start="{{minDate}}" end="{{today}}" bindchange="onDateChange">
        <view class="date-picker">📅 {{game_date}}</view>
      </picker>
      <!-- 明细只留 30 天，再往前录会与已折算的累计值冲突，云端也会拒绝 -->
      <view class="rec-note">只能录最近 {{retentionDays}} 天的对局，更早的已折算进战绩</view>
    </view>

    <!-- 4 个玩家位：填满 3 人记为三麻，填满 4 人记为四麻（自动判定） -->
    <view class="rec-card">
      <view class="rec-label">玩家与点数<text class="rec-label-sub">{{editMode ? '修改对局不能换人' : '三麻留空 4 号位'}}</text></view>
      <view class="slot" wx:for="{{slots}}" wx:key="index" wx:for-index="index" wx:for-item="slot">
        <view class="slot-no">{{index + 1}}号位</view>

        <!-- 已选 -->
        <view wx:if="{{slot}}" class="slot-picked">
          <image class="slot-avatar" src="{{slot.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="slot-name">{{slot.nickname}}</text>
          <input class="slot-points" type="digit" placeholder="点数"
                 value="{{slot.points}}" data-index="{{index}}" bindinput="onPointsInput" />
          <view wx:if="{{!editMode}}" class="slot-remove" data-index="{{index}}" bindtap="removePlayer">✕</view>
        </view>

        <!-- 未选 -->
        <view wx:else class="slot-empty" data-index="{{index}}" bindtap="startSearch">
          ＋ 点击选择玩家<text wx:if="{{index === 3}}" class="slot-hint">（三麻不用填）</text>
        </view>
      </view>

      <!-- 点数合计：人数到 3 人才显示（3 人即三麻、4 人即四麻）。
           边填边对账，差 1000 当场就能看出来，不用等提交 -->
      <view wx:if="{{totalInfo}}" class="total-bar {{totalInfo.ok ? 'total-bar-ok' : ''}}">
        <text class="total-label">{{totalInfo.count}} 人合计</text>
        <text class="total-value">{{totalInfo.sum === null ? '--' : totalInfo.sum}}</text>
        <text class="total-sep">/</text>
        <text class="total-expect">{{totalInfo.expected}}</text>
        <text wx:if="{{totalInfo.hint}}" class="total-hint">{{totalInfo.hint}}</text>
        <text wx:else class="total-hint">✓</text>
      </view>
    </view>

    <view class="rec-tip">{{editMode ? '只改点数或日期，玩家名单不能变；保存后这局的顺位会重新计算' : '填满 3 人记为三麻、4 人记为四麻；顺位按点数自动计算，同分并列同名次'}}</view>

    <view class="rec-submit {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : (editMode ? '保存修改' : '录入本局')}}
    </view>
  </block>

  <!-- 玩家搜索弹层 -->
  <view wx:if="{{searchIndex >= 0}}" class="search-mask" bindtap="cancelSearch">
    <view class="search-panel" catchtap="">
      <view class="search-title">选择 {{searchIndex + 1}} 号位玩家</view>
      <input class="search-input" placeholder="输入昵称搜索" focus
             value="{{keyword}}" bindinput="onKeywordInput" />
      <view class="search-list">
        <view class="search-item" wx:for="{{suggestions}}" wx:key="openid" wx:for-item="u"
              data-user="{{u}}" bindtap="pickPlayer">
          <image class="si-avatar" src="{{u.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="si-name">{{u.nickname}}</text>
        </view>
        <view wx:if="{{!suggestions.length}}" class="search-empty">
          {{keyword ? (searching ? '搜索中…' : '没有找到该用户') : '输入昵称开始搜索'}}
        </view>
      </view>
      <view class="search-cancel" bindtap="cancelSearch">取消</view>
    </view>
  </view>
</view>
