<!-- pages/mahjong/index.wxml -->
<view class="mj-page">
  <!-- 顶部 tab -->
  <view class="mj-tabs" wx:if="{{activeTab !== 'games'}}">
    <view class="mj-tab {{activeTab === 'stats' ? 'mj-tab-active' : ''}}" data-tab="stats" bindtap="switchTab">我的战绩</view>
    <view class="mj-tab {{activeTab === 'rank' ? 'mj-tab-active' : ''}}" data-tab="rank" bindtap="switchTab">排行榜</view>
  </view>

  <!-- ============ 我的战绩 ============ -->
  <block wx:if="{{activeTab === 'stats'}}">
    <!-- 麻币：三麻四麻合并成同一个账户，所以放在模式切换之上 -->
    <view class="mj-card coin-card">
      <view class="coin-left">
        <view class="coin-label">麻币</view>
        <view class="coin-note">四麻三麻合并结算</view>
      </view>
      <view class="coin-value">{{coin}}</view>
    </view>

    <!-- 模式切换：两种模式的战绩完全分开 -->
    <view class="mode-tabs">
      <view class="mode-tab {{statsTab === 'four' ? 'mode-tab-active' : ''}}" data-tab="four" bindtap="switchStatsTab">四麻</view>
      <view class="mode-tab {{statsTab === 'three' ? 'mode-tab-active' : ''}}" data-tab="three" bindtap="switchStatsTab">三麻</view>
    </view>

    <!-- 雀力卡 -->
    <view class="mj-card rank-card">
      <view class="rank-left">
        <view class="rank-label">{{statsTab === 'four' ? '四麻' : '三麻'}}雀力</view>
        <view class="rank-title">{{cur.power != null ? cur.power : '—'}}</view>
        <view class="rank-games">对局 {{cur.games || 0}} 局</view>
      </view>
      <view class="rank-badge">🀄</view>
    </view>

    <!-- 该模式还没打过：只加一行说明，下面的指标骨架照常展示 -->
    <view class="stats-hint" wx:if="{{!cur.games}}">
      <text>还没有{{statsTab === 'four' ? '四麻' : '三麻'}}对局记录，录分后这里会自动填入</text>
    </view>

    <!-- 顺位达成次数：三麻只有 1~3 位，不硬塞一个恒为 0 的四位率 -->
    <!-- 没有对局时也照常渲染，数值显示 --，让用户看得到有哪些指标 -->
    <view class="rate-grid">
      <view class="rate-box rate-1"><view class="rate-name">一位率</view><view class="rate-val">{{cur.games ? cur.rankRates[1] + '%' : '--'}}</view><view class="rate-sub">（{{cur.rankCounts[1] || 0}}回）</view></view>
      <view class="rate-box rate-2"><view class="rate-name">二位率</view><view class="rate-val">{{cur.games ? cur.rankRates[2] + '%' : '--'}}</view><view class="rate-sub">（{{cur.rankCounts[2] || 0}}回）</view></view>
      <view class="rate-box rate-3"><view class="rate-name">三位率</view><view class="rate-val">{{cur.games ? cur.rankRates[3] + '%' : '--'}}</view><view class="rate-sub">（{{cur.rankCounts[3] || 0}}回）</view></view>
      <view class="rate-box rate-4" wx:if="{{statsTab === 'four'}}"><view class="rate-name">四位率</view><view class="rate-val">{{cur.games ? cur.rankRates[4] + '%' : '--'}}</view><view class="rate-sub">（{{cur.rankCounts[4] || 0}}回）</view></view>
    </view>

    <!-- 我的称号（不分模式） -->
    <view class="mj-card title-card" wx:if="{{myTitles.length}}">
      <view class="title-card-head">
        <text class="title-head-label">我的称号</text>
        <text class="title-count">{{titleKinds}} 种</text>
        <!-- 每种只拿过一次时不重复写「共 N 次」，避免 1 种 · 共 1 次的啰嗦 -->
        <text class="title-count-sub" wx:if="{{titleTotal > titleKinds}}">· 共 {{titleTotal}} 次</text>
      </view>
      <!-- 后台有记录但本版本字典不认识：多半是新增称号后前端包没更新，不提示会让人以为是没发上 -->
      <view class="title-unknown" wx:if="{{unknownTitleCount}}">
        另有 {{unknownTitleCount}} 个称号本版本未识别，更新小程序后可见
      </view>
      <view class="title-list">
        <view class="title-badge-wrap" wx:for="{{myTitles}}" wx:key="key">
          <image class="title-badge" src="{{item.img}}" mode="widthFix" />
          <text class="title-badge-count" wx:if="{{item.count > 1}}">×{{item.count}}</text>
          <!-- 主称号高亮标记 + 设置按钮 -->
          <view class="title-main-badge" wx:if="{{mainTitle && mainTitle.key === item.key}}">★展示</view>
          <text class="title-set-main" data-key="{{item.key}}" bindtap="setMainTitle" wx:if="{{!mainTitle || mainTitle.key !== item.key}}">设为展示</text>
        </view>
      </view>
    </view>
    <view class="mj-card title-card title-card-empty" wx:else>
      <view class="title-card-head">我的称号</view>
      <view class="title-unknown" wx:if="{{titlesMissing}}">
        云端未返回称号数据，请部署最新版云函数
      </view>
      <view class="title-unknown" wx:elif="{{unknownTitleCount}}">
        后台有 {{unknownTitleCount}} 个称号，但本版本小程序不认识，请更新后再看
      </view>
      <view class="title-empty" wx:else>胡出役满后找管理员领取称号</view>
    </view>

    <!-- 其他统计 -->
    <view class="rate-grid">
      <view class="rate-box plain"><view class="rate-name">末位率</view><view class="rate-val">{{cur.games ? cur.flyRate + '%' : '--'}}</view></view>
      <view class="rate-box plain"><view class="rate-name">最高点数</view><view class="rate-val">{{cur.maxPoints != null ? cur.maxPoints : '--'}}</view></view>
      <view class="rate-box plain"><view class="rate-name">平均顺位</view><view class="rate-val">{{cur.avgRank != null ? cur.avgRank : '--'}}</view></view>
      <view class="rate-box plain"><view class="rate-name">平均点数</view><view class="rate-val">{{cur.avgPoints != null ? cur.avgPoints : '--'}}</view></view>
    </view>

    <!-- 最近对局顺位趋势 -->
    <view class="mj-card trend-card">
      <view class="trend-head">
        <text class="trend-title">最近对局顺位趋势</text>
        <view class="trend-range">
          <text class="range-btn {{trendRange === 10 ? 'range-active' : ''}}" data-range="10" bindtap="switchTrendRange">10局</text>
          <text class="range-btn {{trendRange === 20 ? 'range-active' : ''}}" data-range="20" bindtap="switchTrendRange">20局</text>
        </view>
      </view>
      <view class="trend-grid">
        <view class="trend-row" wx:for="{{trendRows}}" wx:key="rank" wx:for-item="row">
          <text class="trend-rank-label">{{row.rank}}位</text>
          <view class="trend-cells {{trendRange === 20 ? 'trend-cells--dense' : ''}}">
            <view wx:for="{{row.cells}}" wx:key="index" wx:for-item="cell" wx:for-index="ci"
                  class="trend-cell {{cell.filled ? 'c' + cell.rank : ''}}">
              <!-- 20 局时格子直径只有 20rpx 出头，数字塞不下也不必要：
                   行左侧已标了顺位，颜色深浅同样编码顺位 -->
              <text wx:if="{{cell.filled && trendRange <= 10}}" class="trend-cell-num">{{cell.rank}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 全部对局入口 -->
    <view class="mj-btn" bindtap="showAllGames">全部对局</view>
  </block>

  <!-- ============ 排行榜 ============ -->
  <block wx:if="{{activeTab === 'rank'}}">
    <!-- 三档切换：麻币 / 四麻雀力 / 三麻雀力 -->
    <view class="rank-tabs">
      <view class="rank-tab {{rankTab === 'coin' ? 'rank-tab-active' : ''}}" data-tab="coin" bindtap="switchRankTab">麻币</view>
      <view class="rank-tab {{rankTab === 'power4' ? 'rank-tab-active' : ''}}" data-tab="power4" bindtap="switchRankTab">四麻雀力</view>
      <view class="rank-tab {{rankTab === 'power3' ? 'rank-tab-active' : ''}}" data-tab="power3" bindtap="switchRankTab">三麻雀力</view>
    </view>

    <!-- 规则说明：数值怎么来的，让玩家看得懂 -->
    <view class="rank-tip">
      <text wx:if="{{rankTab === 'coin'}}">每局按顺位结算　四麻 1位+2 / 2位+1 / 3位0 / 4位-1　三麻 1位+2 / 2位0 / 3位-1　最低 0</text>
      <text wx:else>1000 + ({{rankTab === 'power4' ? '2.5' : '2.0'}} − 平均顺位) × 300　满 {{rankConfig.powerMinGames || 10}} 局才入榜</text>
    </view>

    <view class="mj-card rank-head-row">
      <text class="rh-col rh-index">名次</text>
      <text class="rh-col rh-user">用户</text>
      <text class="rh-col rh-num rh-main">{{rankTab === 'coin' ? '麻币' : '雀力'}}</text>
      <text class="rh-col rh-num rh-games">局数</text>
      <text class="rh-col rh-title">称号</text>
    </view>
    <view class="mj-card rank-row"
          wx:for="{{rankList}}" wx:key="openid" wx:for-item="p" wx:for-index="index">
      <text class="rh-col rh-index">{{p.medal || (index + 1)}}</text>
      <view class="rh-col rh-user">
        <image class="rh-avatar" src="{{p.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <text class="rh-name">{{p.nickname}}</text>
      </view>
      <text class="rh-col rh-num rh-main {{rankTab === 'coin' ? 'rh-value-coin' : 'rh-value-power'}}">{{p.value}}</text>
      <text class="rh-col rh-num rh-games">{{p.games}}</text>
      <view class="rh-col rh-title">
        <view class="rh-title-badge-wrap" wx:if="{{p.displayTitle}}">
          <image class="rh-title-badge" src="{{p.displayTitle.img}}" mode="widthFix" />
        </view>
        <text class="rh-title-none" wx:else>—</text>
      </view>
    </view>
    <view wx:if="{{!rankList.length && !loading}}" class="mj-card empty-card">
      <text wx:if="{{rankTab === 'coin'}}">还没有排行榜数据</text>
      <text wx:else>还没有满 {{rankConfig.powerMinGames || 10}} 局{{rankTab === 'power4' ? '四麻' : '三麻'}}的玩家</text>
    </view>
  </block>

  <!-- ============ 全部对局 ============ -->
  <block wx:if="{{activeTab === 'games'}}">
    <view class="mj-back" bindtap="backToStats">‹ 返回战绩</view>
    <view class="mj-card game-card" wx:for="{{games}}" wx:key="_id" wx:for-item="g">
      <view class="game-head">
        <view class="game-left">
          <text class="game-mode {{g.mode === 'three' ? 'game-mode-three' : ''}}">{{g.mode === 'three' ? '三麻' : '四麻'}}</text>
          <text class="game-date">{{g.game_date}}</text>
        </view>
        <view class="game-ops" wx:if="{{isAdmin}}">
          <text class="game-edit" data-id="{{g._id}}" bindtap="editGame">修改</text>
          <text class="game-del" data-id="{{g._id}}" bindtap="deleteGame">删除</text>
        </view>
      </view>
      <view class="game-player {{'gp' + p.rank}}" wx:for="{{g.players}}" wx:key="openid" wx:for-item="p">
        <text class="gp-rank">{{p.rank}}位</text>
        <text class="gp-name">{{p.nickname}}</text>
        <text class="gp-points">{{p.points}}</text>
      </view>
    </view>
    <view wx:if="{{hasMoreGames && games.length}}" class="mj-btn mj-btn-plain" bindtap="loadMoreGames">加载更多</view>
    <view wx:if="{{!games.length && gamesLoaded}}" class="mj-card empty-card"><text>还没有对局记录</text></view>
  </block>

  <!-- 录入入口（所有人可见，云端会校验管理员权限；仅管理员能提交成功） -->
  <view class="mj-record-fab" bindtap="goRecord">＋ 录入</view>
  <view class="mj-record-fab mj-title-fab" bindtap="goGrantTitle">🏅 发称号</view>
  <view class="mj-record-fab mj-adjust-fab" wx:if="{{isAdmin}}" bindtap="goAdjustPlayer">✏ 改数据</view>
</view>
