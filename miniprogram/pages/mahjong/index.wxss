/* pages/mahjong/index.wxss —— 雀魂风格战绩页（淡蓝主题） */
.mj-page {
  padding: 24rpx 24rpx 160rpx;
  flex-shrink: 0;   /* app.wxss page{height:100%} 会压缩子项，必须禁掉 */
}

/* ---------- 顶部 tab ---------- */
.mj-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.16);
}
.mj-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #8aa7c2;
  border-radius: 34rpx;
}
.mj-tab-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}

/* ---------- 通用卡片 ---------- */
.mj-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  flex-shrink: 0;
}

/* ---------- 麻币卡 ---------- */
/* 麻币是三麻四麻合并的一个账户，所以放在模式切换之上，不随 tab 变化 */
.coin-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}
.coin-left { flex: 1; }
.coin-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d5871;
}
.coin-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8bfd4;
}
.coin-value {
  font-size: 46rpx;
  font-weight: 700;
  color: #c9891f;
}

/* ---------- 三麻 / 四麻 模式切换 ---------- */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #8aa7c2;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
}
.mode-tab-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}

/* ---------- 身份卡（头像 + 昵称 + 雀力 + 称号） ---------- */
/* 上半区是身份信息，底部一条是称号入口，所以这里是纵向两段 */
.rank-card {
  display: block;
}
.rank-body {
  display: flex;
  align-items: center;
}
/* 头像在最左，当身份区；没头像时走默认头像（仅本页） */
.rank-avatar {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  margin-right: 22rpx;
  border-radius: 50%;
  background: #e8f1fa;
  border: 2rpx solid #dbe9f5;
}
.rank-left { flex: 1; min-width: 0; }
/* 昵称可能很长（有人爱起十几个字），必须能省略，否则会顶到卡片外面 */
.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 「四麻雀力」标签和数值同一行左对齐：两端对齐会把标签甩到最右边，看着像歪了 */
.rank-power {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}
.rank-label {
  flex: none;
  margin-right: 10rpx;
  font-size: 22rpx;
  color: #8aa7c2;
}
.rank-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4a8ec9;
}
.rank-games {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8aa7c2;
}
/* 展示称号图贴在卡片右侧，宽度比原来小一档：这里只是身份徽章，不再是主角。
   容器固定 200×52（500×130 素材比例），图片用 widthFix 按宽自适应高度（≈52rpx），
   既不会像 aspectFill 那样被放大裁切，也不会因为图片异步加载而让容器高度跳动 */
.rank-title-wrap {
  position: relative;
  flex: none;
  width: 200rpx;
  height: 52rpx;
  margin-left: 18rpx;
}
.rank-title-img {
  width: 200rpx;
  flex: none;
  border-radius: 10rpx;
  display: block;
}
/* 获得次数角标：只有超过 1 次才显示，否则「×1」是句废话 */
.rank-title-count {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  min-width: 40rpx;
  padding: 2rpx 10rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
}
/* 没设置展示称号时的占位块：高度对齐称号图（500×130，200rpx 宽约 52rpx 高） */
.rank-title-none {
  width: 200rpx;
  height: 52rpx;
  flex: none;
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2f7fc;
  border-radius: 10rpx;
  color: #aabfd2;
  font-size: 20rpx;
}
/* 称号入口条：分隔线以上是身份、以下是称号，点整张卡都能打开面板 */
.rank-title-bar {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eef4fa;
}
.rtb-label {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #3d5871;
}
.rtb-count {
  flex: none;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #6fb0e6;
  font-weight: 600;
}
/* 「· 共 N 次」比种类数弱一档，避免两个数字抢注意力 */
.rtb-sub {
  flex: none;
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #8aa6bf;
}
.rtb-more {
  flex: none;
  margin-left: auto;      /* 靠右，和左边的标签拉开 */
  padding-left: 16rpx;
  font-size: 24rpx;
  color: #6fb0e6;
  font-weight: 600;
}
/* 「查看全部 ›」现在是独立可点项，单独给一个按下反馈 */
.rtb-more-hover {
  opacity: 0.6;
}
/* 没有称号时的说明：弱化处理，别让它看起来像报错 */
.rtb-hint {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #aabfd2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 称号图 / 「查看全部」按下反馈：只有这两个地方能点开面板 */
.rank-card-hover {
  opacity: 0.82;
}

/* ---------- 三率 / 统计格 ---------- */
.rate-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.rate-box {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  border: 3rpx solid transparent;
}
/* 四位淡蓝深浅：1位深 → 4位浅 */
.rate-1 { border-color: #6fb0e6; }
.rate-2 { border-color: #8fc4ef; }
.rate-3 { border-color: #aed6f7; }
.rate-4 { border-color: #cfe6fa; }
.rate-name {
  font-size: 24rpx;
  color: #8aa7c2;
}
.rate-val {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d5871;
}
.rate-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #aabfd2;
}

/* ---------- 趋势格 ---------- */
.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
}
.trend-range {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  font-size: 24rpx;
  color: #8aa7c2;
  background: #eef5fb;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
}
.range-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}
.trend-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.trend-rank-label {
  width: 64rpx;
  font-size: 24rpx;
  color: #8aa7c2;
}
.trend-cells {
  flex: 1;
  display: flex;
  /* 圆有最大直径后行宽会有剩余，靠 space-between 摊开，
     否则 10 局时整排挤在左边、右边空一大块 */
  justify-content: space-between;
  gap: 10rpx;
}
/* 20 局时格子窄，间距同步收一点，否则圆小得只剩点、间隙却比圆还大 */
.trend-cells--dense { gap: 6rpx; }
.trend-cell {
  flex: 1;
  min-width: 0;
  /* 行高固定：10 局和 20 局的圆直径本来不同，但每行高度必须一致，
     否则在 10/20 局之间切换时会看到整张卡片高度跳一下 */
  height: 40rpx;
  /* 圆的最大直径 = 行高。格子更宽（10 局）时不再继续放大，
     多出来的空间交给 space-between 分配 */
  max-width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
/* 高度必须跟着宽度走，否则 border-radius: 50% 画出来的是椭圆。
   padding-top 的百分比相对「包含块宽度」计算，伪元素宽度又等于格子宽度，
   所以 padding-top: 100% 得到的就是正方形 —— 这是纯 CSS 做自适应正圆
   的常规写法，比 aspect-ratio 兼容性好（老 iOS WebView 不认后者）。
   格子有固定行高，圆靠 align-items 垂直居中，直径小于行高也不影响行高。 */
.trend-cell::before {
  content: '';
  display: block;
  flex: none;
  width: 100%;
  padding-top: 100%;
  border-radius: 50%;
  background: #eef5fb;
}
/* 顺位格：1位深 → 4位浅（淡蓝） */
.trend-cell.c1::before { background: #6fb0e6; }
.trend-cell.c2::before { background: #8fc4ef; }
.trend-cell.c3::before { background: #aed6f7; }
.trend-cell.c4::before { background: #cfe6fa; }
/* 格内数字：绝对定位盖在圆上，不参与格子尺寸计算 */
.trend-cell-num {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  color: #fff;
  font-weight: 600;
}

/* ---------- 空态 ---------- */
.empty-card {
  text-align: center;
  color: #8aa7c2;
  font-size: 28rpx;
}
/* 无对局时的说明行：不占卡片，避免在页面中段多插一块白底，
   挡住下面本就存在的指标骨架 */
.stats-hint {
  text-align: center;
  color: #8aa7c2;
  font-size: 24rpx;
  padding: 0 0 20rpx;
}

/* ---------- 按钮 ---------- */
.mj-btn {
  background: linear-gradient(90deg, #8fc4ef, #6fb0e6);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(111, 176, 230, 0.35);
}
.mj-btn-plain {
  background: #fff;
  color: #4a8ec9;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.16);
}

/* ---------- 排行榜 ---------- */
/* 三档切换：麻币 / 四麻雀力 / 三麻雀力 */
.rank-tabs {
  display: flex;
  background: #eaf3fc;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 14rpx;
}
.rank-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b89a8;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: background .18s, color .18s;
}
.rank-tab-active {
  background: #fff;
  color: #2f7fc1;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(74, 142, 201, 0.18);
}
/* 规则说明：数值怎么算出来的，一句话写清，避免玩家看不懂分数 */
.rank-tip {
  font-size: 22rpx;
  color: #8aa6bf;
  line-height: 1.6;
  padding: 0 8rpx 16rpx;
}

.rank-head-row, .rank-row {
  display: flex;
  align-items: center;
}
.rank-head-row {
  background: #eaf3fc;
  padding: 18rpx 22rpx;
  color: #4a8ec9;
  font-size: 24rpx;
  font-weight: 600;
}
/* 各列宽度全部 flex: none —— 否则总宽超出时会按比例压缩，
   称号图（内部固定 190rpx）被压到 140rpx 就直接截掉左边一半 */
.rh-index { width: 64rpx; flex: none; }
.rh-user { flex: 1; min-width: 0; display: flex; align-items: center; overflow: hidden; }
.rh-num { width: 110rpx; flex: none; text-align: center; font-size: 28rpx; color: #3d5871; }
/* 主数值列（麻币数 / 雀力）：比局数更醒目，是这张榜的主角 */
.rh-main { width: 116rpx; flex: none; font-weight: 700; font-size: 30rpx; }
.rh-games { width: 72rpx; flex: none; font-size: 24rpx; color: #8aa6bf; }
.rh-value-coin { color: #c9891f; }
.rh-value-power { color: #2f7fc1; }
/* 称号列：宽度必须 ≥ 称号图宽度。原 140rpx < 图 176rpx，右侧对齐 + overflow:hidden
   的结果是把图左边切掉一截，看上去就是「称号显示不全」 */
.rh-title { width: 196rpx; flex: none; display: flex; align-items: center; justify-content: flex-end; overflow: hidden; }
.rh-titles {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: flex-end;
}
.rh-title-badge {
  width: 190rpx;
  border-radius: 10rpx;
  display: block;
}
.rh-title-badge-wrap {
  position: relative;
  width: 190rpx;
  flex: none;
}
.rh-title-badge-count {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  min-width: 30rpx;
  padding: 0 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
  text-align: center;
  border-radius: 13rpx;
}
.rh-title-none { color: #c2d2e2; font-size: 26rpx; }
.rh-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #e8f1fa;
}
.rh-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #3d5871;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-row { padding: 20rpx 22rpx; }

/* ---------- 全部对局 ---------- */
.mj-back {
  font-size: 28rpx;
  color: #4a8ec9;
  margin-bottom: 20rpx;
  padding: 8rpx 4rpx;
}
/* 对局保留期说明：明细只留 7 天，翻到底没有更早的局是设计如此，
   不写清楚会被当成数据丢失来报障 */
.games-note {
  font-size: 23rpx;
  line-height: 1.6;
  color: #8aa7c2;
  padding: 0 8rpx 18rpx;
}
.trend-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8aa7c2;
  text-align: center;
}
.game-card { padding: 20rpx 28rpx; }
.game-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.game-left { display: flex; align-items: center; }
.game-mode {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background: #eef5fb;
  color: #6fb0e6;
}
.game-mode-three { background: #eaf6ef; color: #4fa877; }
.game-date {
  font-size: 26rpx;
  color: #8aa7c2;
}
.game-ops { display: flex; align-items: center; }
.game-edit {
  font-size: 24rpx;
  color: #6fb0e6;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
  border: 1rpx solid #b8d8f0;
  border-radius: 24rpx;
}
.game-del {
  font-size: 24rpx;
  color: #e06c6c;
  padding: 4rpx 16rpx;
  border: 1rpx solid #f0b8b8;
  border-radius: 24rpx;
}
.game-player {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.gp-rank { width: 90rpx; font-weight: 600; }
.gp-name { flex: 1; color: #3d5871; }
.gp-points { font-weight: 700; }
.game-player.gp1 .gp-rank, .game-player.gp1 .gp-points { color: #5a9bd6; }
.game-player.gp2 .gp-rank, .game-player.gp2 .gp-points { color: #7fb4e0; }
.game-player.gp3 .gp-rank, .game-player.gp3 .gp-points { color: #a4cdee; }
.game-player.gp4 .gp-rank, .game-player.gp4 .gp-points { color: #c8e2f7; }

/* ---------- 录入悬浮按钮 ---------- */
.mj-record-fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  background: linear-gradient(135deg, #8fc4ef, #6fb0e6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 32rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 176, 230, 0.45);
}
.mj-title-fab {
  right: 200rpx;
  background: linear-gradient(135deg, #f2a51a, #e6940c);
  box-shadow: 0 8rpx 24rpx rgba(230, 148, 12, 0.45);
}
/* 「发称号」左侧留出的位置：右边缘在 200rpx，宽度约 190rpx，
   所以这一颗从 404rpx 起排，两者不会叠在一起 */
.mj-adjust-fab {
  right: 404rpx;
  background: linear-gradient(135deg, #b58ee8, #9b6fd8);
  box-shadow: 0 8rpx 24rpx rgba(155, 111, 216, 0.45);
}

/* ---------- 称号设置面板（点称号图弹出） ---------- */
/* 遮罩必须盖住两颗悬浮按钮，否则「＋录入」会透在上面被误点 */
.ts-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 48, 68, 0.45);
  z-index: 900;
  animation: ts-fade 0.16s ease-out;
}
.ts-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 901;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 40rpx;
  /* 全面屏底部手势条，不加这条按钮会被压在手势区里点不到 */
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: ts-rise 0.18s ease-out;
}
.ts-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #dbe7f2;
  margin: 0 auto 20rpx;
}
.ts-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}
.ts-head-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d5871;
}
.ts-head-sub {
  font-size: 24rpx;
  color: #8aa6bf;
}
.ts-tip {
  margin-top: 8rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  color: #aabfd2;
}
/* 称号多的时候这里滚，面板高度封顶，底部按钮永远在屏幕内 */
.ts-scroll {
  max-height: 46vh;
  margin: 20rpx 0 4rpx;
}
.ts-grid {
  display: flex;
  flex-wrap: wrap;
  /* 三列：面板左右各 40rpx 内边距，两列 16rpx 间隔；
     左右各留 4rpx，否则选中态的 3rpx 描边会被 scroll-view 裁掉半条 */
  padding: 4rpx;
  gap: 16rpx;
}
.ts-cell {
  position: relative;
  width: 208rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 3rpx solid transparent;
  background: #f7fafd;
}
/* 选中态要一眼看出来：描边 + 淡底，光靠描边在缩略图上不明显 */
.ts-cell-on {
  border-color: #6fb0e6;
  background: #eaf4fd;
}
.ts-cell-hover {
  opacity: 0.8;
}
.ts-cell-img {
  width: 100%;
  border-radius: 10rpx;
  display: block;
}
.ts-cell-count {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  min-width: 36rpx;
  padding: 0 10rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
}
/* 正在展示的那个：右上角一颗星，和「选中」区分开（选中只管这次操作） */
.ts-cell-main {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #6fb0e6;
  color: #fff;
  font-size: 20rpx;
  border-radius: 50%;
}
.ts-btn {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #6fb0e6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
}
/* 已经是展示称号时按钮降一档：这是「撤回」而不是主操作 */
.ts-btn-plain {
  background: #eef5fb;
  color: #4a8ec9;
}
.ts-btn-busy {
  opacity: 0.6;
}
.ts-cancel {
  margin-top: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8aa6bf;
}
@keyframes ts-rise {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
@keyframes ts-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
