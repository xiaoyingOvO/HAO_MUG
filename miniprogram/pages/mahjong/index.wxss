/* pages/mahjong/index.wxss —— 雀魂风格战绩页（淡蓝主题） */
.mj-page {
  padding: 24rpx 24rpx 160rpx;
  flex-shrink: 0;   /* app.wxss page{height:100%} 会压缩子项，必须禁掉 */
}

/* ---------- 顶部 tab ---------- */
.mj-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.16);
}
.mj-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #8aa7c2;
  border-radius: 34rpx;
}
.mj-tab-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}

/* ---------- 通用卡片 ---------- */
.mj-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  flex-shrink: 0;
}

/* ---------- 麻币卡 ---------- */
/* 麻币是三麻四麻合并的一个账户，所以放在模式切换之上，不随 tab 变化 */
.coin-card {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}
.coin-left { flex: 1; }
.coin-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d5871;
}
.coin-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a8bfd4;
}
.coin-value {
  font-size: 46rpx;
  font-weight: 700;
  color: #c9891f;
}

/* ---------- 三麻 / 四麻 模式切换 ---------- */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #8aa7c2;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
}
.mode-tab-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}

/* ---------- 雀力卡 ---------- */
.rank-card {
  display: flex;
  align-items: center;
}
.rank-left { flex: 1; }
.rank-label {
  font-size: 24rpx;
  color: #8aa7c2;
  margin-bottom: 4rpx;
}
.rank-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #4a8ec9;
}
.rank-games {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #8aa7c2;
}
.rank-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b7d9f7, #8fc4ef);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 三率 / 统计格 ---------- */
.rate-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.rate-box {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  border: 3rpx solid transparent;
}
/* 四位淡蓝深浅：1位深 → 4位浅 */
.rate-1 { border-color: #6fb0e6; }
.rate-2 { border-color: #8fc4ef; }
.rate-3 { border-color: #aed6f7; }
.rate-4 { border-color: #cfe6fa; }
.rate-name {
  font-size: 24rpx;
  color: #8aa7c2;
}
.rate-val {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d5871;
}
.rate-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #aabfd2;
}

/* ---------- 我的称号 ---------- */
.title-card { padding: 24rpx 28rpx; }
.title-card-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
  margin-bottom: 20rpx;
}
.title-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.title-badge-wrap {
  position: relative;
  width: 320rpx;
}
.title-badge {
  width: 100%;
  border-radius: 12rpx;
  display: block;
}
.title-badge-count {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  min-width: 40rpx;
  padding: 2rpx 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
}
/* 主称号标记 */
.title-main-badge {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  padding: 2rpx 10rpx;
  background: #6fb0e6;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  border-radius: 12rpx;
}
.title-set-main {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 2rpx 10rpx;
  background: rgba(255,255,255,0.85);
  color: #6fb0e6;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid #6fb0e6;
}
.title-count {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #6fb0e6;
  font-weight: 600;
}
.title-empty {
  color: #aabfd2;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 0;
}

/* ---------- 趋势格 ---------- */
.trend-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.trend-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
}
.trend-range {
  display: flex;
  gap: 12rpx;
}
.range-btn {
  font-size: 24rpx;
  color: #8aa7c2;
  background: #eef5fb;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
}
.range-active {
  background: #b7d9f7;
  color: #3a7bbf;
  font-weight: 600;
}
.trend-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.trend-rank-label {
  width: 64rpx;
  font-size: 24rpx;
  color: #8aa7c2;
}
.trend-cells {
  flex: 1;
  display: flex;
  gap: 10rpx;
}
.trend-cell {
  flex: 1;
  height: 40rpx;
  border-radius: 50%;
  background: #eef5fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
/* 顺位格：1位深 → 4位浅（淡蓝） */
.trend-cell.c1 { background: #6fb0e6; }
.trend-cell.c2 { background: #8fc4ef; }
.trend-cell.c3 { background: #aed6f7; }
.trend-cell.c4 { background: #cfe6fa; }

/* ---------- 空态 ---------- */
.empty-card {
  text-align: center;
  color: #8aa7c2;
  font-size: 28rpx;
}

/* ---------- 按钮 ---------- */
.mj-btn {
  background: linear-gradient(90deg, #8fc4ef, #6fb0e6);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(111, 176, 230, 0.35);
}
.mj-btn-plain {
  background: #fff;
  color: #4a8ec9;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.16);
}

/* ---------- 排行榜 ---------- */
/* 三档切换：麻币 / 四麻雀力 / 三麻雀力 */
.rank-tabs {
  display: flex;
  background: #eaf3fc;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 14rpx;
}
.rank-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b89a8;
  padding: 14rpx 0;
  border-radius: 12rpx;
  transition: background .18s, color .18s;
}
.rank-tab-active {
  background: #fff;
  color: #2f7fc1;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(74, 142, 201, 0.18);
}
/* 规则说明：数值怎么算出来的，一句话写清，避免玩家看不懂分数 */
.rank-tip {
  font-size: 22rpx;
  color: #8aa6bf;
  line-height: 1.6;
  padding: 0 8rpx 16rpx;
}

.rank-head-row, .rank-row {
  display: flex;
  align-items: center;
}
.rank-head-row {
  background: #eaf3fc;
  padding: 18rpx 28rpx;
  color: #4a8ec9;
  font-size: 24rpx;
  font-weight: 600;
}
.rh-index { width: 76rpx; }
.rh-user { flex: 1; display: flex; align-items: center; overflow: hidden; }
.rh-num { width: 110rpx; text-align: center; font-size: 28rpx; color: #3d5871; }
/* 主数值列（麻币数 / 雀力）：比局数更醒目，是这张榜的主角 */
.rh-main { width: 122rpx; font-weight: 700; font-size: 30rpx; }
.rh-games { width: 84rpx; font-size: 24rpx; color: #8aa6bf; }
.rh-value-coin { color: #c9891f; }
.rh-value-power { color: #2f7fc1; }
.rh-title { width: 140rpx; display: flex; align-items: center; justify-content: flex-end; overflow: hidden; }
.rh-titles {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: flex-end;
}
.rh-title-badge {
  width: 176rpx;
  border-radius: 12rpx;
  display: block;
}
.rh-title-badge-wrap {
  position: relative;
  width: 176rpx;
}
.rh-title-badge-count {
  position: absolute;
  right: 4rpx;
  top: 4rpx;
  min-width: 30rpx;
  padding: 0 8rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 26rpx;
  text-align: center;
  border-radius: 13rpx;
}
.rh-title-none { color: #c2d2e2; font-size: 26rpx; }
.rh-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #e8f1fa;
}
.rh-name {
  font-size: 28rpx;
  color: #3d5871;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-row { padding: 20rpx 28rpx; }

/* ---------- 全部对局 ---------- */
.mj-back {
  font-size: 28rpx;
  color: #4a8ec9;
  margin-bottom: 20rpx;
  padding: 8rpx 4rpx;
}
.game-card { padding: 20rpx 28rpx; }
.game-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.game-date {
  font-size: 26rpx;
  color: #8aa7c2;
}
.game-del {
  font-size: 24rpx;
  color: #e06c6c;
  padding: 4rpx 16rpx;
  border: 1rpx solid #f0b8b8;
  border-radius: 24rpx;
}
.game-player {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.gp-rank { width: 90rpx; font-weight: 600; }
.gp-name { flex: 1; color: #3d5871; }
.gp-points { font-weight: 700; }
.game-player.gp1 .gp-rank, .game-player.gp1 .gp-points { color: #5a9bd6; }
.game-player.gp2 .gp-rank, .game-player.gp2 .gp-points { color: #7fb4e0; }
.game-player.gp3 .gp-rank, .game-player.gp3 .gp-points { color: #a4cdee; }
.game-player.gp4 .gp-rank, .game-player.gp4 .gp-points { color: #c8e2f7; }

/* ---------- 录入悬浮按钮 ---------- */
.mj-record-fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  background: linear-gradient(135deg, #8fc4ef, #6fb0e6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 32rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 176, 230, 0.45);
}
.mj-title-fab {
  right: 200rpx;
  background: linear-gradient(135deg, #f2a51a, #e6940c);
  box-shadow: 0 8rpx 24rpx rgba(230, 148, 12, 0.45);
}
