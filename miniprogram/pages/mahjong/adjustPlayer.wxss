/* pages/mahjong/adjustPlayer.wxss —— 管理员手改战绩（淡蓝主题） */
.ap-page {
  padding: 24rpx 24rpx 80rpx;
  flex-shrink: 0;
}
.ap-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(147, 197, 253, 0.14);
  flex-shrink: 0;
}
.ap-noauth {
  text-align: center;
  color: #8aa7c2;
  padding: 80rpx 28rpx;
}
.ap-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d5871;
  margin-bottom: 20rpx;
}
.ap-label-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #aabfd2;
  margin-left: 8rpx;
}
.ap-hint {
  font-size: 23rpx;
  line-height: 1.6;
  color: #8aa7c2;
  padding: 0 8rpx 20rpx;
}

/* 玩家选择 */
.ap-player {
  display: flex;
  align-items: center;
  background: #f2f8fd;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.ap-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #e8f1fa;
  flex: none;
}
.ap-name {
  flex: 1;
  font-size: 30rpx;
  color: #3d5871;
}
.ap-clear { color: #7fb4e0; font-size: 30rpx; padding: 8rpx; }

.ap-input {
  background: #f2f8fd;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #3d5871;
}
.ap-suggest { margin-top: 16rpx; }
.ap-item {
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #eef5fb;
}
.ap-empty {
  font-size: 26rpx;
  color: #aabfd2;
  text-align: center;
  padding: 24rpx 0;
}

/* 分组头 */
.ap-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.ap-group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d5871;
}
.ap-group-sub {
  font-size: 22rpx;
  color: #8aa7c2;
}

/* 字段行 */
.ap-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f7fc;
}
.ap-row:last-child { border-bottom: none; }
.ap-row-label {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.ap-row-name {
  font-size: 27rpx;
  color: #3d5871;
}
.ap-row-auto {
  font-size: 21rpx;
  color: #aabfd2;
  margin-top: 4rpx;
}
.ap-row-input {
  width: 190rpx;
  flex: none;
  background: #f2f8fd;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #3d5871;
  text-align: right;
}
/* 已覆盖的字段用主色描边，一眼能看出哪些是手填的 */
.ap-row-input-on {
  background: #fff;
  border: 1rpx solid #6fb0e6;
  color: #2f6fa8;
  font-weight: 600;
}
.ap-row-reset {
  flex: none;
  font-size: 23rpx;
  color: #7fb4e0;
  padding: 8rpx 0 8rpx 20rpx;
}
.ap-warn {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #e07a3c;
  background: #fff7ef;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  line-height: 1.5;
}

/* 备注与提交 */
.ap-note {
  background: #f2f8fd;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #3d5871;
}
.ap-submit {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #8fc4ef, #6fb0e6);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(111, 176, 230, 0.32);
}
.ap-submit.disabled { opacity: 0.6; }
.ap-reset-all {
  margin-top: 22rpx;
  text-align: center;
  font-size: 25rpx;
  color: #c05a5a;
}

/* 修改历史 */
.ap-log {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f7fc;
}
.ap-log:last-child { border-bottom: none; }
.ap-log-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.ap-log-field {
  font-size: 26rpx;
  color: #3d5871;
}
.ap-log-diff {
  font-size: 25rpx;
  color: #2f6fa8;
  font-weight: 600;
}
.ap-log-sub {
  font-size: 21rpx;
  color: #aabfd2;
  margin-top: 6rpx;
  line-height: 1.5;
}
