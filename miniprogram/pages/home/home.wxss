/* pages/home/home.wxss */
@import "../../style/fonts.wxss";

page {
  --white-box-color: rgba(255, 255, 255, 0.35);
  --main-font-size: 16px;
  --sub-font-size: 14px;
  --prompt-font-size: 13px;
  --status-number-font-size: 30px;
  --main-page-padding: 24rpx;
  --main-box-padding: 24rpx;
  --pretty-font-family: 'FZMiaoWuS-R-GB';
  --number-font-family: 'Digital Numbers';
  --number-color: orange;
  font-size: var(--main-font-size);
  background-color: #f4f7f9;
}

/* --- 卡片样式 --- */
.card {
  width: 95%;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.07);
  overflow: hidden;
  animation: card-slide-up 0.6s ease-out forwards;
}
.card-title-bar {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #e9edf0;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.card-title-bar::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 210rpx;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 3rpx;
  transition: width 0.3s ease-in-out;
}
.card-content {
  padding: 30rpx;
}
/* --- 卡片样式结束 --- */

/* 卡片入场动画 */
@keyframes card-slide-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 小图标 */
.shop__icon, .contact__icon, .FAQ__icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}
.qq__icon, .telephone__icon {
  width: 42rpx;
  height: 42rpx;
  transition: transform 0.2s ease-out;
  margin-right: 12rpx;
  vertical-align: middle;
}
.contact-card .contact view:active .qq__icon,
.contact-card .contact view:active .telephone__icon {
  transform: scale(1.2) rotate(5deg);
}

.vertical-border {
  margin: 0 32rpx;
  border-left: 6rpx solid var(--number-color);
}

.broadcast {
  z-index: 10;
  position: fixed;
  width: 100%;
  padding: 6rpx 12rpx;
  background-color: #fdfddd;
  box-sizing: border-box;
  color: rgb(255, 136, 0);
  font-size: var(--prompt-font-size);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.broadcast > image {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
}
.broadcast > view {
  display: inline-block;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}
.broadcast-text {
  width: 100%;
  display: inline-block;
  white-space: nowrap;
  animation: broadcast 15s linear infinite;
}
.broadcast-text text {
  display: inline-block;
  animation: broadcast 15s linear infinite;
}
.broadcast-text::before {
  content: '';
  display: inline-block;
  width: 100%;
}
.broadcast-text::after {
  content: '';
  display: inline-block;
  width: 100%;
}
@keyframes broadcast {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

.main-logo {
  margin: 0 auto;
  display: flex;
  align-items: center;
  height: 200rpx;
}
.main-logo > image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}
.main-logo > .logo-sidebar {
  margin: 0 40rpx;
  height: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}
.logo-sidebar > text {
  transform: rotate(90deg);
}

/* 店内状态 */
.status-card {
  /* 继承 .card 样式 */
}
.status-card .card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.status-card .current-status-text {
  font-size: 26rpx;
  color: #556c82;
  margin-bottom: 25rpx;
  font-weight: 500;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 25rpx;
}
.wo-customer-status {
  width: 100%;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  padding: 30rpx 0;
  /* background-color: #f8f9fa; */
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.wo-customer-status-amount {
  text-align: center;
  flex: 1;
  align-items: center;
}
.wo-customer-status-amount > text:first-child {
  text-align: center;
  color: #1e3e8a;
  font-family: var(--number-font-family); /* 数字 */
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
}
.wo-customer-status-amount > text:nth-child(2) { /* "人" */
  font-size: 24rpx;
  color: #1e3e8a;
  margin-left: 4rpx;
  line-height: 1;
}
.wo-customer-status-amount > view { /* "正在游玩/休息" */
  font-size: 24rpx;
  color: #475569;
  margin-top: 6rpx;
}
.vertical-border { /* 分隔线 */
  margin: 0;
  width: 4rpx;
  border: none;
  border-radius: 2rpx;
  background: linear-gradient(180deg, #a7f3d0, #67e8f9);
  box-shadow: 0 0 10rpx rgba(56, 189, 248, 0.7),
              inset 2rpx 0 2rpx rgba(15, 23, 42, 0.2);
  align-self: stretch;
}

.wo-customer-total {
  font-size: 28rpx;
  color: #444;
  margin-bottom: 30rpx;
  font-weight: 500;
  text-align: center;
}

.wo-join-button-container {
  display: flex;
  width: 100%;
  gap: 25rpx;
  justify-content: center;
}
.wo-join-button { /* 按钮样式 */
  flex: 1;
  max-width: 280rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border: none;
  /* box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1); */
  position: relative;
  overflow: hidden;
  transition: transform 0.1s ease-out;
}
.wo-join-button::after { border: none; }
.wo-join-button:active { transform: scale(0.97); }

.wo-join-button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  padding-top: 200%;
  border-radius: 50%;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 60%);
  transform: translate(-50%, -50%) scale(0);
  transition: transform 0.5s ease-out, opacity 0.5s ease-out;
  opacity: 0;
}

.button-enter { background: linear-gradient(135deg, #4CAF50, #81C784); color: white; box-shadow: 0 6rpx 15rpx rgba(40, 167, 69, 0.35); }
.button-leave { background: linear-gradient(135deg, #FF9800, #FFB74D); color: white; box-shadow: 0 6rpx 15rpx rgba(253, 126, 20, 0.35); }
.button-opendoor { background: linear-gradient(135deg, #2196F3, #64B5F6); color: white; box-shadow: 0 6rpx 15rpx rgba(0, 123, 255, 0.35); }
.button-reserve { background: linear-gradient(135deg, #9C27B0, #CE93D8); color: white; box-shadow: 0 6rpx 15rpx rgba(156, 39, 176, 0.35); }
.button-disable {
  background-color: #e0e0e0;
  color: #999;
  box-shadow: none;
}

/* 已入店时，开门按钮单独放下方一行 */
.wo-opendoor-container {
  display: flex;
  width: 100%;
  margin-top: 20rpx;
  justify-content: center;
}
.wo-opendoor-container .wo-join-button {
  flex: none;
  width: 280rpx;
}


.wo-status-subtitle { /* 入店时长和消费 */
  font-size: 26rpx;
  color: #555;
  margin-top: 30rpx;
  text-align: center;
  width: 100%;
}
.wo-status-subtitle > text {
  color: #e53935;
  font-weight: bold;
  margin: 0 4rpx;
}

/* 联系方式和常见问题 - 应用卡片样式 */
.contact-card, .faq-card { /* 替换 .main-box */
  /* 继承 .card 样式 */
}

.contact-card .card-content .contact view { /* 联系方式行 */
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
  margin-bottom: 10rpx;
}
.contact-card .card-content .contact text:first-child { /* "企鹅：" */
  color: #777;
  margin-right: 10rpx;
}

.contact-detail.tappable {  /* 可点击样式  */
  color: #007aff;
  text-decoration: underline;
  text-decoration-color: rgba(43, 134, 197,0.4);
  cursor: pointer;
}
.contact-detail.tappable:active { /* 点击反馈 */
  opacity: 0.7;
}
.selectable-text {  /* 下划线样式 */
  color: #007aff;
  text-decoration: underline;
  text-decoration-color: #007aff;
  padding: 2rpx 0;
}

  /* 强调样式 */
  .card .highlight {
    color: #d97706;
  }
  
  .card .highlight.strong {
      color: #e54d42;
  }


.faq-card .faq-item { /* FAQ 每个问题 */
  border-bottom: 1rpx solid #f0f2f5;
  padding: 25rpx 0;
}
.faq-card .faq-item:last-child {
  border-bottom: none;
}
.faq-q { /* 问题行 */
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  cursor: pointer;
  padding: 15rpx 0;
  transition: color 0.3s ease-in-out, background-color 0.2s ease-out;
}
.faq-q:active {
    background-color: #f7f8fa;
}
.faq-q > image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 15rpx;
  transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 0.1);
  opacity: 0.6;
}
.faq-q-extended > image {
  transform: rotate(90deg);
  opacity: 1;
}
.faq-q-extended {
    color: #007aff;
    padding-left: 15rpx;
    border-radius: 8rpx;
    background: linear-gradient(90deg, rgba(0, 122, 255, 0.05) 0%, rgba(0, 122, 255, 0) 100%);
}

.faq-a {  /* 答案行 */
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  display: grid;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.4s ease-out, opacity 0.3s ease-in-out, padding 0.3s ease-out;  /* 更平滑的动画效果 */
}
.faq-a > view {
  padding: 20rpx 12rpx 10rpx;
  /* border-left: 2rpx solid #007aff; */
  background-color: #f8f9fa;
  border-radius: 0 8rpx 8rpx 0;
}
.faq-a-show {
  max-height: 4000rpx;
  opacity: 1;
}
.faq-a image {
  max-width: 100%;
  border-radius: 8rpx;
  margin-top: 15rpx;
}
.faq-a-hidden {
  grid-template-rows: 0fr;
}
.faq-a-show {
  grid-template-rows: 1fr;
}

/* ============================================================
 * 欠费提醒（费用扣成负数时只提示，不踢出队列）
 * ============================================================ */
.overdraft-warning {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(229, 57, 53, 0.10) 0%, rgba(229, 57, 53, 0.04) 100%);
  border-left: 6rpx solid #e53935;
  color: #c62828;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: left;
}

/* ============================================================
 * 入店 · 设备选择弹层
 * ============================================================ */
.device-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  /* 要盖住 login-fab（z-index: 1000）和 custom-navi（999），否则浮动按钮会穿到弹层上面 */
  z-index: 1100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: deviceMaskIn 0.2s ease-out;
}
@keyframes deviceMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.device-panel {
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: devicePanelIn 0.26s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes devicePanelIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
/* 新增：关闭动画 */
.device-panel-closing {
  animation: devicePanelOut 0.26s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}
@keyframes devicePanelOut {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

.device-head {
  text-align: center;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.device-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}
.device-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.device-list {
  flex: 1;
  max-height: 58vh;
  padding: 8rpx 0;
}

.device-group {
  margin-top: 20rpx;
}

/* 卡片本体不可点：不给 :active 反馈，避免误导用户去点配图/名称 */
.device-group-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f8fa;
  border: 3rpx solid transparent;
}

.device-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 14rpx;
  flex: none;
  background: #e9ecef;
}

.device-meta {
  flex: 1;
  min-width: 0;
}
.device-name {
  font-size: 31rpx;
  font-weight: 600;
  color: #222;
}
.device-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a9099;
}

.device-children {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 4rpx;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease-out, opacity 0.25s ease-out, padding 0.3s ease-out;
}
.device-children-show {
  max-height: 260rpx;
  opacity: 1;
  padding: 18rpx 4rpx 4rpx;
}

/* 子项卡片：整块可点（选中即高亮），不再单独的「入队」按钮 */
.device-child {
  flex: 1;
  min-width: 180rpx;
  padding: 20rpx 12rpx 16rpx;
  border-radius: 14rpx;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #d8dde3;
}
.device-child-name {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #222;
}
.device-child-tag {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #07C160;
}
/* 子项人数：该机台自己的排队人数（游玩中 + 排队中） */
.device-child-count {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 500;
  color: #8a9099;
}

.device-cancel {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
  background: #f2f3f5;
  transition: opacity 0.15s ease-out;
}
.device-cancel:active {
  background: #e6e8eb;
}
/* 选中设备后，底部「取消」变成「入队 / 入店」确认按钮 */
.device-confirm {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #4CAF50, #81C784);
}
.device-confirm:active {
  background: linear-gradient(135deg, #43A047, #66BB6A);
}

/* 选中态高亮 */
.device-selected {
  border-color: #07C160;
  background: #f2fbf6;
}
.device-count {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.count-green {
  color: #07C160;
  background: rgba(7, 193, 96, 0.10);
}
.count-orange {
  color: #ff9800;
  background: rgba(255, 152, 0, 0.10);
}
.count-red {
  color: #e53935;
  background: rgba(229, 57, 53, 0.10);
}
