<!--pages/queue-info/index.wxml-->
<view class="login-overlay" wx:if="{{showLoginOverlay}}">
  <view class="overlay-content">
    <text>登录入店才可以参与排卡噢~</text>
    <button bindtap="redirectToLogin">前往登录</button>
  </view>
</view>

<!-- 右侧内容模板（复用：拖拽时 / 平时） -->
<template name="queueContent">
  <!-- 游玩区：台上的人按上机先后从上往下排（先上机的在最上面），一人一张卡，
       不再按座位分格子。末尾只剩一个「空位」块 —— 几个空座合成一块，点它切换拼机 / 单刷。 -->
  <view class="playing-area">
    <view
      wx:for="{{playingList}}"
      wx:key="key"
      class="playing-seat {{item.type === 'empty' ? 'seat-empty' : item.type === 'locked' ? 'seat-locked' : 'seat-player'}}"
      data-position="{{index}}"
      bindtap="toggleSingle">
      <block wx:if="{{item.type === 'player'}}">
        <image class="seat-avatar" src="{{item.player.avatar}}" mode="aspectFill"></image>
        <view class="seat-info">
          <view class="seat-name">{{item.player.nickname}}</view>
        </view>
        <!-- 单刷标签：贴在卡片最右边，只写「单刷」两个字。
             单刷的人独占整台机，剩下座位不会再排人，末尾的空位块会变红写「单刷」。 -->
        <view wx:if="{{item.player.isMulti === false}}" class="seat-single-tag">单刷</view>
      </block>
      <block wx:elif="{{item.type === 'locked'}}">
        <view class="seat-locked-text">单刷</view>
      </block>
      <block wx:else>
        <view class="seat-empty-text">{{item.freeCount > 1 ? '还有 ' + item.freeCount + ' 个空位' : '空位'}}</view>
      </block>
    </view>
  </view>

  <!-- 等候区汇总：一个孤零零的序号看不出「还要等多久」，这里直接给结论 -->
  <view wx:if="{{waitingTotal > 0}}" class="queue-summary">
    <text class="queue-summary-count">等候 {{waitingTotal}} 人</text>
    <text wx:if="{{myQueueNo > 0}}" class="queue-summary-me">{{myAhead > 0 ? '我排第 ' + myQueueNo + ' 位，前面还有 ' + myAhead + ' 人' : '我排第 1 位，下一位就是我'}}</text>
    <text wx:elif="{{myPlaying}}" class="queue-summary-me">我正在游玩</text>
  </view>

  <!-- 等候区 -->
  <view class="waiting-list">
    <card
    wx:for="{{waitingList}}"
      wx:key="openid"
      wx:for-item="player"
      class="card real-card"
      style="{{showDragClone && dragIndex === index ? 'visibility: hidden;' : ''}}"
      player="{{player}}"
      player-index="{{index}}"
      data-index="{{index}}"
      bind:dragstart="dragStart"
      bind:dragmove="dragMove"
      bind:dragend="dragEnd" />
    <!-- 跟手的克隆卡。位置用 transform 走合成层，不用 top，避免每帧触发重排 -->
    <card wx:if="{{showDragClone}}"
      id="clone-player"
      style="position: absolute; top: 0; left: 0; width: {{cloneRect.width}}px; z-index: 999; pointer-events: none; transform: translate3d(0, {{cloneRect.top}}px, 0);"
      player="{{clonePlayer}}"
      player-index="{{dragIndex}}"
    />
  </view>
</template>

<view class="container">
  <!-- 欠费提醒 -->
  <view wx:if="{{overdraft}}" class="queue-overdraft">
    余额已透支{{overdraftShortage > 0 ? ' ' + overdraftShortage + ' 点' : ''}}，请及时充值。队列位置已保留，可随时退队。
  </view>

  <!-- 机台列表一到就先渲染排卡板，不再等「入店状态校验」全部完成。
       入店校验只决定底部按钮文字，没必要挡住整块内容。 -->
  <view wx:if="{{machines.length > 0}}" class="queue-layout">
    <!-- 左：机台列表 -->
    <!-- 左侧机台列表：bounces 关掉，避免下拉时出现「像在刷新」的回弹 -->
    <!-- scroll-into-view：进页面自动选中「我正在排的那一队」时，若它在列表下方，
         列表会自动滚过去，不用手动找 -->
    <scroll-view class="machine-list" scroll-y enhanced show-scrollbar="{{false}}" bounces="{{false}}"
      scroll-into-view="{{machineScrollIntoView}}" scroll-with-animation>
      <view
        wx:for="{{machines}}"
        wx:key="machineId"
        id="machine-{{item.machineId}}"
        class="machine-item {{selectedMachine.machineId === item.machineId ? 'machine-item-active' : ''}}"
        bind:tap="switchMachine"
        data-machine-index="{{index}}">
        {{item.machineName}}
      </view>
    </scroll-view>

    <!-- 右：游玩区 + 等候区 -->
    <view class="queue-area-wrap">
      <!-- 拖拽中把 scroll-y 关掉，否则长按拖动时列表会跟着手指滚（安卓/iOS 都这样）。
           ⚠️ 不要加 enhanced：增强模式下由原生接管滚动，scroll-y 的动态切换不生效
           bounces 关掉：下拉时不再回弹，看起来就不会像「在下拉刷新」 -->
      <scroll-view class="queue-area" scroll-y="{{!showDragClone}}" bounces="{{false}}">
        <template is="queueContent" data="{{playingList, waitingList, showDragClone, clonePlayer, cloneRect, dragIndex, canSwitchMulti, waitingTotal, myQueueNo, myAhead, myPlaying}}" />
      </scroll-view>
    </view>
  </view>
  <!-- 骨架：比一行「loading」体感快得多，也是审核员进页面第一眼看到的东西 -->
  <view wx:elif="{{queueErrorText === 'loading'}}" class="queue-skeleton">
    <view class="sk-col-left">
      <view class="sk-block sk-machine" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </view>
    <view class="sk-col-right">
      <view class="sk-seat-row">
        <view class="sk-block sk-seat" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
      <view class="sk-block sk-card" wx:for="{{[1,2]}}" wx:key="*this"></view>
    </view>
  </view>
  <view wx:else class="queue-error">{{queueErrorText}}</view>
</view>

<!-- 底部：主按钮 + 设置（日志、强制下机等都收进了设置页） -->
<view class="enqueue-button">
  <view class="enqueue-main">
    <button wx:if="{{checkQueueError}}" class="button-disabled" type="primary" disabled>{{enqueueButtonText}}</button>
    <button wx:elif="{{myIndex >= 0 && playlist[myIndex].order == 0}}" class="button-deplain" bind:tap="handleDeplainBtn" type="primary">下机</button>
    <!-- 退队按钮只写「退队」：位次卡面上已经有了，按钮里再带一遍纯属重复，
         而且人在队伍里位次会随时变，按钮文字跟着跳反而让人以为排错队 -->
    <button wx:elif="{{myIndex >= 0}}" class="button-dequeue" bind:tap="handleDequeueBtn" type="primary">退队</button>
    <button wx:else class="button-enqueue" bind:tap="handleEnqueueBtn" type="primary">入队</button>
  </view>
  <button class="button-settings" bind:tap="toSettings" size="mini">设置</button>
</view>