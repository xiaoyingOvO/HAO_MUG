/* pages/queue-info/index.wxss */
page {
  --white-box-color: rgba(255, 255, 255, 0.4);
  --dark-box-color: rgba(0, 0, 0, 0.6);
  --white-extend-color: rgba(255, 255, 255, 0.8);
  --white-extend-hover-color: rgba(220, 220, 220, 0.8);
  --main-text-color: #0c0c0c;
  --dark-text-color: #ffffff;
  --multi-button-background-color: transparent;
  --multi-button-text-color: #0c0c0c;
  --single-button-background-color: rgba(0, 0, 0, 0.2);
  --single-button-text-color: #ffffff;
  --page-bottom-margin: 36rpx;
}
button {
  margin: 0;
}

.login-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.2); 
    /* background-color: rgba(0, 0, 0, 0.3); */
    z-index: 999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40rpx;
    box-sizing: border-box;
  }

  .overlay-content {
    background-color: #ffffff;
    padding: 10rpx 10rpx 10rpx 10rpx;
    border-radius: 20rpx;
    text-align: center;
    box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.15);
    width: 80%;
    max-width: 600rpx;
    border: 2rpx solid #007aff;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

/* 主要内容 */
.container {
  padding: 12rpx 24rpx;
  /* 底部固定按钮（.enqueue-button）是 position:fixed，不占文档流，
     这里补出它的高度：按钮 100rpx + 底距 36rpx，再加安全区。
     以前是让 .queue-layout 用 calc(100vh - 160rpx - 136rpx) 去减，
     多减出来的那 160rpx 让板子底部空了一大截。 */
  padding-bottom: 136rpx;
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
  align-items: stretch;
  /* 撑满 page 剩余高度，让子级用 flex:1 分配，不再依赖 100vh 计算 */
  flex: 1;
  min-height: 0;
}
/* 等候区 */
.waiting-list {
  position: relative;
  background-color: #f6f6f6;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
/* 等候区汇总条：左边「等候 N 人」，右边直接给结论「我排第 M 位，前面还有 K 人」。
   只有一个孤零零的序号时，用户还得自己数座位才知道什么时候轮到自己。 */
.queue-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx 16rpx;
  font-size: 24rpx;
  color: #8a9099;
}
.queue-summary-count {
  flex: none;
  color: #606773;
  font-weight: 600;
}
.queue-summary-me {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ff6b00;
  font-weight: 600;
}
.white-box {
  background-color: var(--white-box-color);
}
.dark-box {
  background-color: var(--dark-box-color);
}
.white-box .player-info, .white-box .user-action-buttons button {
  color: var(--main-text-color);
}
.dark-box .player-info, .dark-box .user-action-buttons button {
  color: var(--dark-text-color);
}
  .playlist-item {
    padding: 0 12rpx;
    height: 180rpx;
    
    box-shadow: rgba(100, 100, 111, 0.2) 7rpx 7rpx 29rpx 0rpx;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 24rpx;
  }
  .player-index {
    min-width: 1ch;
    max-width: 2ch;
    font-size: 25px;
    color: #9c9c9c;
  }
  .player-info {
    font-size: 17px;
    display: inline-flex;
    align-items: center;
    gap: 36rpx;
    flex: 1;
  }
    .player-info > image {
      box-sizing: border-box;
      width: 150rpx;
      height: 150rpx;
      border-radius: 50%;
      border: pink 1rpx solid;
      flex: none;
    }
  .user-action-buttons {
    width: fit-content;
    margin-left: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: stretch;
  }
    .user-action-buttons > .drag-img {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

.queue-error {
  text-align: center;
  font-size: 22px;
}

/* 底部：主按钮 + 日志 */
.enqueue-button {
  width: 100%;
  height: 100rpx;
  position: fixed;
  bottom: var(--page-bottom-margin);
  left: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.enqueue-button .button-disabled {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}
.enqueue-button .button-dequeue {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}
.enqueue-button .button-dequeue:active {
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.4);
}

.enqueue-main {
  flex: 1;
}
.enqueue-main button {
  width: 100%;
  border-radius: 25rpx;
  background: linear-gradient(135deg, #007aff, #5ac8fa);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  border: none;
  transition: all 0.2s ease-out;
}
.enqueue-main button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.4);
}
.enqueue-main .button-disabled {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}
.enqueue-main .button-dequeue {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}
.enqueue-main .button-dequeue:active {
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.4);
}
.enqueue-main .button-deplain {
  background: linear-gradient(135deg, #ff9800, #ffb74d);
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}
.enqueue-main .button-deplain:active {
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.4);
}

/* 设置按钮（右侧） */
.button-settings {
  flex: none;                /* ← 关键：不拉伸 */
  width: 120rpx;             /* ← 固定宽度 */
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #007aff, #5ac8fa);
  color: white;
  font-size: 26rpx;
  font-weight: 400;
  padding: 0;
}
.button-settings:active {
  background: #e6e8eb;
}

/* ============================================================
 * 欠费提醒（费用扣成负数时只提示，不踢出队列）
 * ============================================================ */
.queue-overdraft {
  margin: 16rpx 0 4rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(229, 57, 53, 0.10) 0%, rgba(229, 57, 53, 0.04) 100%);
  border-left: 6rpx solid #e53935;
  color: #c62828;
  font-size: 25rpx;
  line-height: 1.5;
}

/* ============================================================
 * 左右分栏布局
 * ============================================================ */
 .queue-layout {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 12rpx;
  /* 高度不再用 100vh 硬算：页面顶部有没有内容、env() 支不支持、
     100vh 含不含导航栏，各机型算出来的值都不一样。
     改成 flex:1 吃掉 .container 的剩余空间，高度自然就是对的。 */
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

/* 左：机台列表 */
.machine-list {
  flex: none;
  width: 200rpx;
  height: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.machine-item {
  padding: 20rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  background: #f6f7f9;
  word-break: break-all;
}
.machine-item-active {
  background: linear-gradient(135deg, #4CAF50, #81C784);
  color: #ffffff;
  font-weight: 600;
}

/* 右：游玩区 + 等候区 */
.queue-area {
  flex: 1;
  height: 100%;
}
.playing-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.playing-seat {
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.seat-player {
  background: #ffffff;
  border: 3rpx solid #07C160;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.15);
}
.seat-empty {
  background: #f0f1f3;
  border: 3rpx dashed #d0d3d8;
}
.seat-locked {
  background: #ffe5e5;
  border: 3rpx solid #e53935;
  /* 「单刷」标签也靠右，和上面玩家卡右角的单刷标签对齐成一列 */
  justify-content: flex-end;
}
/* 「单刷」标签：和玩家卡右侧的 .seat-single-tag 同一套外观（红字 + 浅红底 + 红边），
   只是这块在卡片左边。改样式时两处一起改，别长成两个样子。 */
.seat-locked-text {
  display: inline-block;
  box-sizing: border-box;
  padding: 0 14rpx;
  height: 40rpx;
  line-height: 38rpx;   /* 减掉上下 1rpx 边框，文字正好垂直居中 */
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
  color: #e53935;
  background: rgba(229, 57, 53, 0.12);
  border: 1rpx solid rgba(229, 57, 53, 0.25);
}
/* 空位块：几个空座合成一块，写清还剩几个（游玩区不再一人一格） */
.seat-empty-text {
  font-size: 26rpx;
  color: #9aa0a8;
}
.seat-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  flex: none;
  background: #e9ecef;
}
/* 座位里的文字区：只有昵称（「先上机 / 后上机」标签已去掉，顺序本身就说明了先后） */
.seat-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}
.seat-name {
  max-width: 100%;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 单刷标签：贴在玩家卡片最右边（margin-left:auto 顶到行尾），只写「单刷」。
   颜色和「单刷锁定块」同一套红，看到这个就知道整台机不会再排别人。 */
.seat-single-tag {
  flex: none;
  margin-left: auto;
  box-sizing: border-box;
  padding: 0 14rpx;
  height: 40rpx;
  line-height: 38rpx;   /* 减掉上下 1rpx 边框，文字正好垂直居中 */
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
  color: #e53935;
  background: rgba(229, 57, 53, 0.12);
  border: 1rpx solid rgba(229, 57, 53, 0.25);
}
.queue-area-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.queue-area-wrap .queue-area {
  flex: 1;
  height: 100%;
}
/* 隐藏滚动条（原先靠 scroll-view 的 show-scrollbar，那是增强模式专属属性，
   拖拽需要动态切 scroll-y 所以不能开增强模式，改在样式里隐藏） */
.queue-area::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
/* ===== 首屏骨架 =====
   机台列表还没回来时占位。布局尺寸与 .queue-layout 保持一致，
   数据到了直接顶替，不会发生跳动。 */
.queue-skeleton {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 12rpx;
  /* 与 .queue-layout 保持一致：flex:1 撑满，避免骨架和真实内容高度不一致导致跳动 */
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}
.sk-col-left {
  flex: none;
  width: 200rpx;
  height: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}
.sk-col-right {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sk-block {
  background: linear-gradient(90deg, #eceef1 25%, #f5f6f8 37%, #eceef1 63%);
  background-size: 400% 100%;
  animation: sk-shimmer 1.2s ease infinite;
  border-radius: 14rpx;
}
.sk-machine {
  height: 76rpx;
  margin-bottom: 12rpx;
}
.sk-seat-row {
  display: flex;
  gap: 12rpx;
}
.sk-seat {
  flex: 1;
  height: 120rpx;
  border-radius: 20rpx;
}
.sk-card {
  height: 110rpx;
  border-radius: 20rpx;
}
@keyframes sk-shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
