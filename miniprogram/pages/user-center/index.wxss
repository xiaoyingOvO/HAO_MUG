/* Navigation Card Styles */
.nav-card {
  padding: 30rpx;
}
.nav-card__title {
  position: relative;
  font-size: 34rpx;
  font-weight: 600;
  padding-left: 24rpx;
  margin-bottom: 30rpx;
  display: inline-block;
  background: linear-gradient(90deg, #3a506b, #1c2541);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}
.nav-card__title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #89f7fe, #66a6ff);
  border-radius: 4rpx;
}

.nav-card__actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.nav-card__actions--wrap {
   flex-wrap: wrap;
   justify-content: flex-start;
   gap: 20rpx;
}



.nav-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  font-size: 24rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  color: #666;
  text-align: center;
  border: 1rpx solid #eee;
  transition: all 0.2s ease-in-out;
  line-height: 1.4;
}
.button.nav-button::after {
    border: none;
}

.button-badge-wrapper {
  position: relative;
  margin-bottom: 8rpx;
}
.badge {
  position: absolute;
  top: 20rpx;
  right: 55rpx;
  background-color: #ff4d4f;
  color: white;
  font-size: 20rpx;
  border-radius: 20rpx;
  padding: 4rpx 10rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 25rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid white;
}

/* */
.nav-button--secondary {
    flex: 0 0 calc(33.33% - 14rpx);
    height: 150rpx;
}


.nav-button__icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 15rpx;
}

.nav-button:active {
  background-color: #e9ecef;
  transform: scale(0.98);
}

/* 管理入口按钮 */
.admin-entry-container {
  margin-top: 40rpx;
  padding: 0 30rpx;
}

.divider {
  height: 1rpx;
  background-color: #e0e0e0;
  margin-bottom: 40rpx;
}

.admin-entry-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(135deg, #6a82fb, #fc5c7d);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 15rpx rgba(106, 130, 251, 0.3);
  border: none;
}
.admin-entry-btn::after {
  border: none;
}
.admin-entry-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}
.admin-entry-btn > text {
  white-space: nowrap;
}

/* 登录卡片 */
.login-card {
  padding: 0;
  background-color: transparent;
  box-shadow: none;
  margin-top: 30rpx;
}
.login-card__actions {
  padding: 0 30rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s ease-out, box-shadow 0.2s ease-out;
  line-height: 1;
  padding: 0;
}
.login-btn::after {
  border: none;
}
.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.4);
}


/* 动画 */
@keyframes card-slide-down {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-slide-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animation-slide-down {
  animation: card-slide-down 0.5s ease-out forwards;
}

.animation-slide-up {
  animation: card-slide-up 0.5s ease-out forwards;
}
@keyframes glowing-border-lv1 {
  0%, 100% { border-color: #43e97b; box-shadow: 0 0 5rpx #43e97b, 0 0 10rpx #43e97b; }
  50% { border-color: #38f9d7; box-shadow: 0 0 15rpx #38f9d7, 0 0 25rpx #38f9d7; }
}
@keyframes glowing-border-lv2 {
  0%, 100% { border-color: #89f7fe; box-shadow: 0 0 5rpx #89f7fe, 0 0 10rpx #89f7fe; }
  50% { border-color: #66a6ff; box-shadow: 0 0 15rpx #66a6ff, 0 0 25rpx #66a6ff; }
}
@keyframes glowing-border-lv3 {
  0%, 100% { border-color: #ff9a9e; box-shadow: 0 0 5rpx #ff9a9e, 0 0 10rpx #ff9a9e; }
  50% { border-color: #fecfef; box-shadow: 0 0 15rpx #fecfef, 0 0 25rpx #fecfef; }
}
@keyframes glowing-border-lv4 {
  0%, 100% { border-color: #bdc3c7; box-shadow: 0 0 5rpx #bdc3c7, 0 0 10rpx #bdc3c7; }
  50% { border-color: #e0e0e0; box-shadow: 0 0 15rpx #e0e0e0, 0 0 25rpx #e0e0e0; }
}
@keyframes glowing-border-lv5 {
  0%, 100% { border-color: #f6d365; box-shadow: 0 0 5rpx #f6d365, 0 0 10rpx #f6d365; }
  50% { border-color: #fda085; box-shadow: 0 0 15rpx #fda085, 0 0 25rpx #fda085; }
}
@keyframes glowing-border-lv6 {
  0%, 100% { border-color: #ff3cac; box-shadow: 0 0 8rpx #ff3cac, 0 0 18rpx #ff3cac; }
  33% { border-color: #a64dff; box-shadow: 0 0 15rpx #a64dff, 0 0 25rpx #a64dff; }
  66% { border-color: #2b86c5; box-shadow: 0 0 15rpx #2b86c5, 0 0 25rpx #2b86c5; }
}
@keyframes subtle-shine {
    0%, 100% { transform: translateX(-150%) skewX(-25deg); }
    50% { transform: translateX(150%) skewX(-25deg); }
}

.glowing-effect .user-card_level,
.glowing-effect .user-card__avatar {
  animation-duration: 10s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.glowing-effect .user-card__avatar {
  box-shadow: 0 0 5rpx #fff; 
}
.glowing-effect .user-card_level {
  position: relative;
  overflow: hidden;
  border-width: 2rpx;
  border-style: solid;
  z-index: 0;
}
.glowing-effect .user-card_level::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 75%;
  height: 100%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.6) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  animation: subtle-shine 5s linear infinite;
  animation-delay: 1s;
  transform: translateX(-150%);
}
.glowing-effect--1 .user-card_level,
.glowing-effect--1 .user-card__avatar {
  animation-name: glowing-border-lv1;
}
.glowing-effect--2 .user-card_level,
.glowing-effect--2 .user-card__avatar {
  animation-name: glowing-border-lv2;
}
.glowing-effect--3 .user-card_level,
.glowing-effect--3 .user-card__avatar {
  animation-name: glowing-border-lv3;
}
.glowing-effect--4 .user-card_level,
.glowing-effect--4 .user-card__avatar {
  animation-name: glowing-border-lv4;
}
.glowing-effect--5 .user-card_level,
.glowing-effect--5 .user-card__avatar {
  animation-name: glowing-border-lv5;
}
.glowing-effect--6 .user-card_level,
.glowing-effect--6 .user-card__avatar,
.glowing-effect--MAX .user-card_level,
.glowing-effect--MAX .user-card__avatar {
  animation-name: glowing-border-lv6;
  animation-duration: 10s; 
}
.user-card__avatar {
  border-width: 8rpx;
}

/* 经验条动画 */
@keyframes particle-flow {
  0% {
    background-position: 200% 50%;
  }
  100% {
    background-position: -200% 50%;
  }
}
/* 满级 */
@keyframes rainbow-shimmer {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes breathing-glow {
  0%, 100% {
    box-shadow: 0 0 12rpx 2rpx var(--progress-glow-color),
                inset 0 1px 1px rgba(255, 255, 255, 0.4);
  }
  50% {
    box-shadow: 0 0 28rpx 7rpx var(--progress-glow-color),
                inset 0 1px 1px rgba(255, 255, 255, 0.4);
  }
}

