/* pages/user-center/other-page/membership.wxss */
.container.membership-page {
    padding: 30rpx;
    background-color: #f8f9fa;
    color: #333;
  }
  
  .section {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 30rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  }
  
  .section-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #ecf0f1;
    display: flex;
    align-items: center;
  }
  .title-icon {
      width: 40rpx;
      height: 40rpx;
      margin-right: 15rpx;
  }
  
  .intro-text {
    display: block;
    font-size: 28rpx;
    line-height: 1.7;
    color: #555;
    margin-bottom: 30rpx;
  }
  
  /* 表格样式 */
  .level-rules-table,
  .credit-rules-table {
    width: 100%;
    border: 1rpx solid #e0e6ed;
    border-radius: 8rpx;
    overflow: hidden;
    margin-bottom: 30rpx;
  }
  
  .table-header,
  .table-row {
    display: flex;
    width: 100%;
  }
  
  .table-header {
    background-color: #f2f6fc;
    font-weight: bold;
    color: #303133;
    font-size: 26rpx;
  }
  
  .table-row {
    border-top: 1rpx solid #e0e6ed;
  }
  .table-row:first-child { /* 如果表头是独立 view */
      /* border-top: none; */
  }
  
  
  .table-cell {
    flex: 1;
    padding: 20rpx 15rpx;
    font-size: 26rpx;
    line-height: 1.5;
    text-align: center;
    border-right: 1rpx solid #e0e6ed;
    word-break: break-word; /* 允许换行 */
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .table-cell:last-child {
    border-right: none;
  }
  
  /* 列宽度调整 */
  .table-header .table-cell:nth-child(1),
  .table-row .table-cell:nth-child(1) { /* 等级/信用等级列 */
    flex: 0.8;
  }
  .table-header .table-cell:nth-child(3),
  .table-row .table-cell:nth-child(3) { /* 特权/影响列 */
    flex: 1.8;
    text-align: left;
  }
  .table-row .table-cell.perks,
  .table-row .table-cell.effects {
      text-align: left;
  }
  
  
  /* 等级和信用徽章样式 */
  .level-badge, .credit-badge {
    font-weight: bold;
    padding: 6rpx 12rpx;
    border-radius: 6rpx;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
  }
  /* 等级徽章 */
